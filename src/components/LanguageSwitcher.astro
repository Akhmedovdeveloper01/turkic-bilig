---
import { turkicLocales, otherLocales } from '../i18n/locales';
import { createTranslator } from '../i18n/ui';

interface Props {
  currentLang: string;
}

const { currentLang } = Astro.props;
const t = createTranslator(currentLang);

// Joriy sahifadagi til qismini almashtirib, qolgan yo'lni saqlab qolamiz
// (masalan /uz/xalqlar/ozbeklar -> /tr/xalqlar/ozbeklar).
const segments = Astro.url.pathname.split('/').filter(Boolean);
const rest = segments.slice(1).join('/');
function pathFor(code: string): string {
  return rest ? `/${code}/${rest}` : `/${code}/`;
}
---

<details class="tb-popover group relative">
  <summary
    class="flex h-10 cursor-pointer list-none items-center gap-1.5 rounded-full border border-line bg-surface-alt px-3 text-sm font-medium text-ink transition-colors hover:border-brand/40 hover:text-brand sm:h-auto sm:py-1.5 [&::-webkit-details-marker]:hidden"
    aria-label={t('languageSwitcher.label')}
  >
    <svg viewBox="0 0 24 24" class="h-4 w-4" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
      <circle cx="12" cy="12" r="9" />
      <path d="M3 12h18M12 3c2.5 2.6 3.8 5.7 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.7-3.8-9S9.5 5.6 12 3Z" />
    </svg>
    <!-- Telefonda va gorizontal menyu ko'rinadigan xl oralig'ida joy tejash uchun faqat belgi; nomi aria-label orqali aytiladi. -->
    <span class="hidden whitespace-nowrap sm:inline xl:hidden 2xl:inline">{t('languageSwitcher.label')}</span>
  </summary>
  <div
    class="absolute end-0 z-10 mt-2 w-64 rounded-xl border border-line bg-surface p-3 shadow-lg shadow-ink/5"
  >
    <p class="mb-1.5 px-1 text-xs font-semibold uppercase tracking-wide text-ink-muted">
      {t('languageSwitcher.turkic')}
    </p>
    <ul class="mb-3 grid grid-cols-2 gap-0.5">
      {turkicLocales.map((locale) => (
        <li>
          <a
            href={pathFor(locale.code)}
            class:list={[
              'block rounded-md px-2 py-1 text-sm transition-colors hover:bg-surface-alt hover:text-brand',
              locale.code === currentLang ? 'font-semibold text-brand' : 'text-ink',
            ]}
            aria-current={locale.code === currentLang ? 'true' : undefined}
          >
            {locale.endonym}
          </a>
        </li>
      ))}
    </ul>
    <p class="mb-1.5 px-1 text-xs font-semibold uppercase tracking-wide text-ink-muted">
      {t('languageSwitcher.other')}
    </p>
    <ul class="grid grid-cols-2 gap-0.5">
      {otherLocales.map((locale) => (
        <li>
          <a
            href={pathFor(locale.code)}
            class:list={[
              'block rounded-md px-2 py-1 text-sm transition-colors hover:bg-surface-alt hover:text-brand',
              locale.code === currentLang ? 'font-semibold text-brand' : 'text-ink',
            ]}
            aria-current={locale.code === currentLang ? 'true' : undefined}
          >
            {locale.endonym}
          </a>
        </li>
      ))}
    </ul>
  </div>
</details>
