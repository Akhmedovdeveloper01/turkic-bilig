---
/**
 * Ilmiy meros kartochkasi: sana, soha, kim tomonidan (avtomatik), ta'sir
 * dalillari (har biri manba bilan) va ta'sir zanjiri.
 */
import { getEntry } from 'astro:content';
import { createTranslator } from '../../i18n/ui';
import { getLocale, defaultLocale } from '../../i18n/locales';
import { formatYear } from '../../i18n/years';
import type { Contribution } from '../../lib/contributions';
import ActorBadge from './ActorBadge.astro';

interface Props {
  lang: string;
  item: Contribution;
}
const { lang, item } = Astro.props;
const t = createTranslator(lang);
const { facts, entry } = item;
const endonym = (getLocale(lang) ?? getLocale(defaultLocale)!).endonym;

const sourceLabel = async (refs: { id: string; collection: 'sources' }[]) =>
  (await Promise.all(refs.map((r) => getEntry(r))))
    .filter((s) => s !== undefined)
    // Kitob — "Muallif (yil)"; yili yo'q ensiklopediya — nomi (muharrirlar ro'yxati emas).
    .map((s) => (s.data.year ? `${s.data.author} (${s.data.year})` : s.data.title))
    .join('; ');
const impact = await Promise.all(entry.data.impact.map(async (i) => ({ text: i.text, source: await sourceLabel(i.sourceIds) })));
const chain = facts.chain
  .map((c) => ({ year: c.year, text: entry.data.chainTexts[c.id] }))
  .filter((c) => c.text);
const year = `${facts.yearUncertain ? '≈ ' : ''}${formatYear(t, facts.year, facts.era)}`;
---

<li id={item.id} class="tb-reveal scroll-mt-24 rounded-xl border border-line bg-surface-alt p-5" data-category={facts.domain}>
  <div class="mb-2 flex flex-wrap items-center gap-2 text-xs">
    <span class="font-semibold tabular-nums text-ink">{year}</span>
    <span class="rounded-full border border-line bg-surface px-2.5 py-0.5 font-medium text-ink-muted">{t(`heritage.domain.${facts.domain}`)}</span>
    <ActorBadge lang={lang} actor={item.actor} />
  </div>

  <h3 class="text-lg font-semibold text-ink">{entry.data.title}</h3>
  <p class="mt-1.5 text-sm text-ink-muted">{entry.data.summary}</p>

  <div class="mt-4">
    <p class="mb-1.5 text-xs font-semibold uppercase tracking-wide text-ink-muted">{t('heritage.impactTitle')}</p>
    <ul class="space-y-2">
      {impact.map((i) => (
        <li class="border-s-2 border-gold/60 ps-3 text-sm text-ink">
          {i.text}
          <span class="mt-0.5 block text-[0.7rem] text-ink-muted">{t('states.symbolSource')}: {i.source}</span>
        </li>
      ))}
    </ul>
  </div>

  {chain.length > 0 && (
    <div class="mt-4">
      <p class="mb-1.5 text-xs font-semibold uppercase tracking-wide text-ink-muted">{t('heritage.chainTitle')}</p>
      <ol class="flex flex-wrap items-stretch gap-2 text-sm">
        {chain.map((c, i) => (
          <li class="flex items-center gap-2">
            <span class="rounded-lg border border-line bg-surface px-3 py-1.5 text-ink">
              {c.year !== undefined && <span class="me-1.5 font-semibold tabular-nums text-brand">{c.year}</span>}
              {c.text}
            </span>
            {i < chain.length - 1 && <span aria-hidden="true" class="text-ink-muted rtl:-scale-x-100">→</span>}
          </li>
        ))}
      </ol>
    </div>
  )}

  <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
    {item.scholars.map((s) => (
      <a href={`/${lang}/allomalar/${s.slug}`} class="font-medium text-brand hover:underline">{s.title}</a>
    ))}
    {item.states.map((s) => (
      <a href={`/${lang}/davlatlar/${s.slug}`} class="font-medium text-brand hover:underline">{s.title}</a>
    ))}
    <span class="ms-auto flex flex-wrap gap-1">
      {facts.evidence.map((e) => (
        <span class="rounded bg-surface px-1.5 py-0.5 text-[0.7rem] text-ink-muted">{t(`heritage.evidence.${e}`)}</span>
      ))}
    </span>
  </div>

  {item.isFallback && <p class="mt-3 text-xs text-gold">{t('translation.notTranslated', { lang: endonym })}</p>}
</li>
