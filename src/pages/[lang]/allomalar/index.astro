---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import EntryCard from '../../../components/EntryCard.astro';
import DidYouKnow from '../../../components/DidYouKnow.astro';
import { locales } from '../../../i18n/locales';
import { createTranslator } from '../../../i18n/ui';
import ScholarCategoryBadge from '../../../components/scholars/ScholarCategoryBadge.astro';
import ScholarPortrait from '../../../components/scholars/ScholarPortrait.astro';
import { formatYear } from '../../../i18n/years';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { lang: locale.code } }));
}

const { lang } = Astro.params;
const t = createTranslator(lang!);

const facts = await getCollection('scholarFacts');

const items = await Promise.all(
  facts.map(async (fact) => {
    const slug = fact.id;
    const localized = await getEntry('scholars', `${lang}/${slug}`);
    const original = localized ?? (await getEntry('scholars', `uz/${slug}`));
    return { slug, entry: original, isFallback: !localized, facts: fact.data };
  })
);

// Tug'ilgan yil bo'yicha (bo'lmasa — vafot yilidan 60 yil oldin deb taxminlanadi, faqat tartib uchun).
const orderYear = (f: (typeof items)[number]['facts']) => f.birthYear ?? (f.deathYear !== undefined ? f.deathYear - 60 : 9999);
items.sort((a, b) => orderYear(a.facts) - orderYear(b.facts));

const lifeSpan = (f: (typeof items)[number]['facts']) => {
  const b = f.birthYear !== undefined ? formatYear(t, f.birthYear, f.birthEra) : '?';
  const d = f.deathYear !== undefined ? formatYear(t, f.deathYear, f.deathEra) : '?';
  if (b === '?' && d === '?') return null;
  return `${f.datesUncertain ? '≈ ' : ''}${b} – ${d}`;
};

const CATEGORY_ACCENT = { turkiy: 'bg-cat-turkiy', mintaqaviy: 'bg-cat-sulola', munozarali: 'bg-cat-munozarali' } as const;

const FILTERS = [
  { value: 'hammasi', label: t('states.filterAll'), count: items.length },
  ...(['turkiy', 'mintaqaviy', 'munozarali'] as const).map((c) => ({
    value: c,
    label: t(c === 'turkiy' ? 'scholars.categoryTurkiy' : c === 'mintaqaviy' ? 'scholars.categoryMintaqaviy' : 'scholars.categoryMunozarali'),
    count: items.filter((i) => i.facts.category === c).length,
  })),
].filter((f) => f.count > 0);
---

<BaseLayout lang={lang!} title={t('nav.scholars')}>
  <PageHero lang={lang!} image="allomalar" alt={t('hero.altScholars')} title={t('nav.scholars')} lead={t('hero.scholarsLead')} fit="contain" />
  <p class="mb-5 text-sm text-ink-muted">{t('scholars.sortedNote')}</p>

  <DidYouKnow
    lang={lang!}
    items={items
      .filter((i) => i.entry)
      .map((i) => ({
        href: `/${lang}/allomalar/${i.slug}`,
        title: i.entry!.data.title,
        accentClass: CATEGORY_ACCENT[i.facts.category],
        cards: i.entry!.data.didYouKnow,
      }))}
    note={t('scholars.didYouKnowNote')}
  />

  <div class="tb-filter" data-scholar-list>
    <div class="mb-4 max-w-md" data-search-box hidden>
      <label for="scholar-search" class="sr-only">{t('scholars.searchLabel')}</label>
      <div class="relative">
        <svg viewBox="0 0 24 24" class="pointer-events-none absolute start-3 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-muted" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5" stroke-linecap="round"></path>
        </svg>
        <input
          id="scholar-search"
          type="search"
          autocomplete="off"
          placeholder={t('scholars.searchPlaceholder')}
          class="w-full rounded-full border border-line bg-surface-alt py-2 ps-9 pe-4 text-sm text-ink placeholder:text-ink-muted focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/30"
          data-search-input
        />
      </div>
      <p class="sr-only" aria-live="polite" data-search-status data-found={t('scholars.searchFound')}></p>
    </div>
    <fieldset class="mb-6">
      <legend class="sr-only">{t('scholars.filterLegend')}</legend>
      <div class="flex flex-wrap gap-2">
        {FILTERS.map((f) => (
          <label class="tb-filter-tab">
            <input type="radio" name="scholar-category" value={f.value} checked={f.value === 'hammasi'} class="sr-only" />
            <span>{f.label}</span>
            <span class="tb-filter-count tabular-nums">{f.count}</span>
          </label>
        ))}
      </div>
    </fieldset>
  <ul class="grid gap-4 sm:grid-cols-2">
    {items.map(({ slug, entry, isFallback, facts }, index) => entry && (
      <EntryCard
        lang={lang!}
        href={`/${lang}/allomalar/${slug}`}
        title={entry.data.title}
        summary={entry.data.summary}
        isFallback={isFallback}
        index={index}
        category={facts.category}
        searchText={facts.field.join(' ')}
      >
        {facts.portrait && <ScholarPortrait slot="media" lang={lang!} name={entry.data.title} portrait={facts.portrait} variant="card" />}
        <div class="flex flex-wrap items-center gap-2">
          {lifeSpan(facts) && <span class="text-xs font-medium tabular-nums text-ink-muted">{lifeSpan(facts)}</span>}
          <ScholarCategoryBadge lang={lang!} category={facts.category} />
        </div>
      </EntryCard>
    ))}
  </ul>
  <p class="py-8 text-center text-sm text-ink-muted" data-search-empty hidden>{t('scholars.searchEmpty')}</p>
  </div>
</BaseLayout>

<script>
  // Allomalar ro'yxati ichida qidiruv. Toifa filtri CSS (:has) bilan ishlaydi,
  // qidiruv unga qo'shimcha: mos kelmagan kartochkaga data-search-hidden qo'yiladi.
  // JavaScript o'chiq bo'lsa, qidiruv maydoni umuman ko'rinmaydi.
  const root = document.querySelector<HTMLElement>('[data-scholar-list]');
  if (root) {
    const box = root.querySelector<HTMLElement>('[data-search-box]')!;
    const input = root.querySelector<HTMLInputElement>('[data-search-input]')!;
    const status = root.querySelector<HTMLElement>('[data-search-status]')!;
    const empty = root.querySelector<HTMLElement>('[data-search-empty]')!;
    const cards = [...root.querySelectorAll<HTMLElement>('[data-search]')];

    // Kichik harf, diakritikasiz; o' / o‘ / oʻ / o` kabi tutuq belgilari bir xil.
    const normalize = (text: string) =>
      text
        .toLocaleLowerCase()
        .normalize('NFD')
        .replace(/\p{M}/gu, '')
        .replace(/['‘’ʻʼ`´]/g, '')
        .replace(/\s+/g, ' ')
        .trim();
    const haystacks = new Map(cards.map((c) => [c, normalize(c.dataset.search ?? '')]));

    const update = () => {
      const terms = normalize(input.value).split(' ').filter(Boolean);
      for (const card of cards) {
        const text = haystacks.get(card)!;
        card.toggleAttribute('data-search-hidden', !terms.every((term) => text.includes(term)));
      }
      const visible = cards.filter((c) => getComputedStyle(c).display !== 'none').length;
      empty.hidden = visible > 0;
      status.textContent = terms.length > 0 ? (status.dataset.found ?? '').replace('{n}', String(visible)) : '';
    };

    box.hidden = false;
    input.addEventListener('input', update);
    root.addEventListener('change', update);
  }
</script>
