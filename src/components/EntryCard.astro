---
import { createTranslator } from '../i18n/ui';
import { getLocale, defaultLocale } from '../i18n/locales';

interface Props {
  lang: string;
  href: string;
  title: string;
  summary: string;
  isFallback: boolean;
  index?: number;
}
const { lang, href, title, summary, isFallback, index = 0 } = Astro.props;
const t = createTranslator(lang);
const endonym = (getLocale(lang) ?? getLocale(defaultLocale)!).endonym;
const delay = `${Math.min(index, 8) * 0.06}s`;
---

<li
  class="tb-reveal group rounded-xl border border-line bg-surface-alt p-5 transition-all duration-300 hover:-translate-y-1 hover:border-brand/40 hover:shadow-lg hover:shadow-brand/10"
  style={`transition-delay: ${delay};`}
>
  <a href={href} class="text-lg font-semibold text-ink group-hover:text-brand">
    {title}
  </a>
  <p class="mt-1.5 text-sm text-ink-muted">{summary}</p>
  {Astro.slots.has('default') && <div class="mt-3"><slot /></div>}
  {isFallback && (
    <p class="mt-3 text-xs text-gold">{t('translation.notTranslated', { lang: endonym })}</p>
  )}
</li>
