---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OrnamentDivider from '../../components/OrnamentDivider.astro';
import Logo from '../../components/Logo.astro';
import { locales } from '../../i18n/locales';
import { createTranslator } from '../../i18n/ui';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { lang: locale.code } }));
}

const { lang } = Astro.params;
const t = createTranslator(lang!);
---

<BaseLayout lang={lang!}>
  <section class="relative -mx-4 overflow-hidden px-6 py-16 text-center sm:py-24" style="border-radius: 1.5rem;">
    <div
      class="tb-animate-gradient absolute inset-0 -z-10"
      style="background-image: var(--gradient-hero); opacity: 0.14;"
    >
    </div>

    <div class="pointer-events-none absolute -left-4 top-8 tb-animate-float" style="animation-duration: 9s;">
      <Logo class="h-16 w-16 text-brand/10" />
    </div>
    <div class="pointer-events-none absolute right-4 top-16 tb-animate-float" style="animation-duration: 6.5s; animation-delay: -2s;">
      <Logo class="h-10 w-10 text-accent/15" />
    </div>
    <div class="pointer-events-none absolute bottom-6 left-1/4 tb-animate-float" style="animation-duration: 8s; animation-delay: -4s;">
      <Logo class="h-8 w-8 text-gold/25" />
    </div>

    <div class="relative mx-auto max-w-2xl">
      <p
        class="tb-animate-fade-up mb-3 text-sm font-semibold uppercase tracking-widest text-brand"
        style="animation-delay: 0s;"
      >
        {t('home.heroTagline')}
      </p>
      <h1
        class="tb-animate-fade-up mb-4 text-4xl font-bold tracking-tight text-ink sm:text-5xl"
        style="animation-delay: 0.1s;"
      >
        {t('site.title')}
      </h1>
      <p class="tb-animate-fade-up text-lg text-ink-muted" style="animation-delay: 0.2s;">
        {t('home.heroLead')}
      </p>
      <div class="tb-animate-fade-up" style="animation-delay: 0.3s;">
        <OrnamentDivider class="mx-auto mt-8 max-w-xs text-accent/40" />
      </div>
    </div>
  </section>

  <section class="mx-auto mt-4 grid max-w-4xl gap-5 sm:grid-cols-3">
    <a
      href={`/${lang}/xalqlar`}
      class="tb-animate-fade-up group rounded-2xl border border-line bg-surface-alt p-6 transition-all duration-300 hover:-translate-y-1 hover:border-brand/40 hover:shadow-lg hover:shadow-brand/10"
      style="animation-delay: 0.35s;"
    >
      <svg
        viewBox="0 0 24 24"
        class="mb-4 h-8 w-8 text-brand transition-transform duration-300 group-hover:scale-110"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
      >
        <circle cx="9" cy="8" r="3" /><circle cx="17" cy="9" r="2.4" />
        <path d="M3.5 19c.6-3 2.7-5 5.5-5s4.9 2 5.5 5M15 14.6c2.2.2 3.9 1.9 4.4 4.4" />
      </svg>
      <h2 class="mb-1 font-semibold text-ink group-hover:text-brand">{t('home.peoplesCardTitle')}</h2>
      <p class="text-sm text-ink-muted">{t('home.peoplesCardDesc')}</p>
    </a>

    <a
      href={`/${lang}/mavzular`}
      class="tb-animate-fade-up group rounded-2xl border border-line bg-surface-alt p-6 transition-all duration-300 hover:-translate-y-1 hover:border-brand/40 hover:shadow-lg hover:shadow-brand/10"
      style="animation-delay: 0.45s;"
    >
      <svg
        viewBox="0 0 24 24"
        class="mb-4 h-8 w-8 text-brand transition-transform duration-300 group-hover:scale-110"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
      >
        <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H19v15.5H6.5A2.5 2.5 0 0 0 4 21V5.5Z" />
        <path d="M4 18.5A2.5 2.5 0 0 1 6.5 16H19" />
      </svg>
      <h2 class="mb-1 font-semibold text-ink group-hover:text-brand">{t('home.topicsCardTitle')}</h2>
      <p class="text-sm text-ink-muted">{t('home.topicsCardDesc')}</p>
    </a>

    <a
      href={`/${lang}/davlatlar`}
      class="tb-animate-fade-up group rounded-2xl border border-line bg-surface-alt p-6 transition-all duration-300 hover:-translate-y-1 hover:border-brand/40 hover:shadow-lg hover:shadow-brand/10"
      style="animation-delay: 0.55s;"
    >
      <svg
        viewBox="0 0 24 24"
        class="mb-4 h-8 w-8 text-brand transition-transform duration-300 group-hover:scale-110"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
      >
        <path d="M4 21V10l8-6 8 6v11M4 21h16M9 21v-6h6v6" />
      </svg>
      <h2 class="mb-1 font-semibold text-ink group-hover:text-brand">{t('home.statesCardTitle')}</h2>
      <p class="text-sm text-ink-muted">{t('home.statesCardDesc')}</p>
    </a>
  </section>
</BaseLayout>
