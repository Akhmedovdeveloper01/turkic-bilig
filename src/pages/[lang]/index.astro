---
import { Image } from 'astro:assets';
import heroBg from '../../assets/heroes/bosh.jpg';
import heroImages from '../../data/hero-images.json';
import BaseLayout from '../../layouts/BaseLayout.astro';
import OrnamentDivider from '../../components/OrnamentDivider.astro';
import Logo from '../../components/Logo.astro';
import { locales } from '../../i18n/locales';
import { createTranslator } from '../../i18n/ui';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { lang: locale.code } }));
}

const { lang } = Astro.params;
const t = createTranslator(lang!);
---

<BaseLayout lang={lang!}>
  <section
    class="relative -mx-4 overflow-hidden bg-[#0d1b1e] px-6 py-24 text-center shadow-2xl shadow-brand/30 sm:py-32"
    style="border-radius: 1.75rem;"
  >
    <Image
      src={heroBg}
      alt={t('hero.altHome')}
      widths={[640, 1024, 1600, 2200]}
      sizes="(min-width: 1152px) 1152px, 100vw"
      loading="eager"
      class="absolute inset-0 h-full w-full object-cover"
      style="object-position: 50% 45%"
    />
    <div class="tb-animate-gradient absolute inset-0 opacity-[0.78]" style="background-image: var(--gradient-hero);" aria-hidden="true"></div>
    <p class="absolute bottom-2 end-4 text-[0.65rem] text-white/70">
      {t('common.photoCredit')}: <a href={heroImages.bosh.sourceUrl} class="underline decoration-white/40 hover:text-white">{heroImages.bosh.author}</a>, {heroImages.bosh.license}
    </p>
    <div class="pointer-events-none absolute -left-8 top-4 tb-animate-float" style="animation-duration: 8s;">
      <Logo class="h-28 w-28 text-white/20" />
    </div>
    <div class="pointer-events-none absolute right-2 top-10 tb-animate-float" style="animation-duration: 6s; animation-delay: -1.5s;">
      <Logo class="h-20 w-20 text-white/25" />
    </div>
    <div class="pointer-events-none absolute bottom-6 left-[15%] tb-animate-float" style="animation-duration: 7s; animation-delay: -3s;">
      <Logo class="h-14 w-14 text-white/20" />
    </div>
    <div class="pointer-events-none absolute -bottom-4 right-[12%] tb-animate-float" style="animation-duration: 9s; animation-delay: -5s;">
      <Logo class="h-24 w-24 text-white/15" />
    </div>
    <div class="pointer-events-none absolute right-1/3 top-1/2 tb-animate-float" style="animation-duration: 10s; animation-delay: -2s;">
      <Logo class="h-10 w-10 text-white/20" />
    </div>

    <div class="relative mx-auto max-w-2xl">
      <p
        class="tb-animate-fade-up mb-3 text-sm font-bold uppercase tracking-[0.2em] text-white/90"
        style="animation-delay: 0s;"
      >
        {t('home.heroTagline')}
      </p>
      <h1
        class="tb-animate-fade-up mb-5 text-5xl font-extrabold tracking-tight text-white drop-shadow-sm sm:text-7xl"
        style="animation-delay: 0.1s;"
      >
        {t('site.title')}
      </h1>
      <p class="tb-animate-fade-up text-lg text-white/90 sm:text-xl" style="animation-delay: 0.2s;">
        {t('home.heroLead')}
      </p>
      <div class="tb-animate-fade-up" style="animation-delay: 0.3s;">
        <OrnamentDivider class="mx-auto mt-10 max-w-xs text-white/50" />
      </div>
    </div>
  </section>

  <section class="mx-auto mt-8 grid max-w-4xl gap-5 sm:grid-cols-3">
    <a
      href={`/${lang}/xalqlar`}
      class="tb-animate-fade-up group relative overflow-hidden rounded-2xl border border-line bg-surface-alt p-6 transition-all duration-300 hover:-translate-y-2 hover:border-brand/50 hover:shadow-2xl hover:shadow-brand/20"
      style="animation-delay: 0.35s;"
    >
      <div class="absolute inset-0 -z-10 opacity-0 transition-opacity duration-300 group-hover:opacity-100" style="background-image: var(--gradient-hero);"></div>
      <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand/10 transition-all duration-300 group-hover:scale-110 group-hover:rotate-6 group-hover:bg-white/20">
        <svg viewBox="0 0 24 24" class="h-6 w-6 text-brand transition-colors duration-300 group-hover:text-white" fill="none" stroke="currentColor" stroke-width="1.6">
          <circle cx="9" cy="8" r="3" /><circle cx="17" cy="9" r="2.4" />
          <path d="M3.5 19c.6-3 2.7-5 5.5-5s4.9 2 5.5 5M15 14.6c2.2.2 3.9 1.9 4.4 4.4" />
        </svg>
      </div>
      <h2 class="mb-1 font-bold text-ink transition-colors duration-300 group-hover:text-white">{t('home.peoplesCardTitle')}</h2>
      <p class="text-sm text-ink-muted transition-colors duration-300 group-hover:text-white/85">{t('home.peoplesCardDesc')}</p>
    </a>

    <a
      href={`/${lang}/mavzular`}
      class="tb-animate-fade-up group relative overflow-hidden rounded-2xl border border-line bg-surface-alt p-6 transition-all duration-300 hover:-translate-y-2 hover:border-brand/50 hover:shadow-2xl hover:shadow-brand/20"
      style="animation-delay: 0.45s;"
    >
      <div class="absolute inset-0 -z-10 opacity-0 transition-opacity duration-300 group-hover:opacity-100" style="background-image: var(--gradient-hero);"></div>
      <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand/10 transition-all duration-300 group-hover:scale-110 group-hover:rotate-6 group-hover:bg-white/20">
        <svg viewBox="0 0 24 24" class="h-6 w-6 text-brand transition-colors duration-300 group-hover:text-white" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H19v15.5H6.5A2.5 2.5 0 0 0 4 21V5.5Z" />
          <path d="M4 18.5A2.5 2.5 0 0 1 6.5 16H19" />
        </svg>
      </div>
      <h2 class="mb-1 font-bold text-ink transition-colors duration-300 group-hover:text-white">{t('home.topicsCardTitle')}</h2>
      <p class="text-sm text-ink-muted transition-colors duration-300 group-hover:text-white/85">{t('home.topicsCardDesc')}</p>
    </a>

    <a
      href={`/${lang}/davlatlar`}
      class="tb-animate-fade-up group relative overflow-hidden rounded-2xl border border-line bg-surface-alt p-6 transition-all duration-300 hover:-translate-y-2 hover:border-brand/50 hover:shadow-2xl hover:shadow-brand/20"
      style="animation-delay: 0.55s;"
    >
      <div class="absolute inset-0 -z-10 opacity-0 transition-opacity duration-300 group-hover:opacity-100" style="background-image: var(--gradient-hero);"></div>
      <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand/10 transition-all duration-300 group-hover:scale-110 group-hover:rotate-6 group-hover:bg-white/20">
        <svg viewBox="0 0 24 24" class="h-6 w-6 text-brand transition-colors duration-300 group-hover:text-white" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M4 21V10l8-6 8 6v11M4 21h16M9 21v-6h6v6" />
        </svg>
      </div>
      <h2 class="mb-1 font-bold text-ink transition-colors duration-300 group-hover:text-white">{t('home.statesCardTitle')}</h2>
      <p class="text-sm text-ink-muted transition-colors duration-300 group-hover:text-white/85">{t('home.statesCardDesc')}</p>
    </a>
  </section>
</BaseLayout>
