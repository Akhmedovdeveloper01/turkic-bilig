---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import EntryCard from '../../../components/EntryCard.astro';
import { locales } from '../../../i18n/locales';
import { createTranslator } from '../../../i18n/ui';
import StateCategoryBadge from '../../../components/states/StateCategoryBadge.astro';
import StatesStats from '../../../components/states/StatesStats.astro';
import StatesTimeline from '../../../components/states/StatesTimeline.astro';
import CapitalsMap from '../../../components/map/CapitalsMap.astro';
import StatesGenealogy from '../../../components/states/StatesGenealogy.astro';
import DidYouKnow from '../../../components/states/DidYouKnow.astro';
import { formatPeriod, sortableYear } from '../../../i18n/years';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { lang: locale.code } }));
}

const { lang } = Astro.params;
const t = createTranslator(lang!);

const facts = await getCollection('stateFacts');

const items = await Promise.all(
  facts.map(async (fact) => {
    const slug = fact.id;
    const localized = await getEntry('states', `${lang}/${slug}`);
    const original = localized ?? (await getEntry('states', `uz/${slug}`));
    return { slug, entry: original, isFallback: !localized, facts: fact.data };
  })
);
const FILTERS = [
  { value: 'hammasi', label: t('states.filterAll'), count: items.length },
  ...(['turkiy', 'turkiy-sulola', 'munozarali'] as const).map((c) => ({
    value: c,
    label: t(c === 'turkiy' ? 'states.categoryTurkiy' : c === 'turkiy-sulola' ? 'states.categorySulola' : 'states.categoryMunozarali'),
    count: items.filter((i) => i.facts.category === c).length,
  })),
];

// Tashkil topgan yili bo'yicha (miloddan avvalgilar birinchi).
items.sort(
  (a, b) =>
    sortableYear(a.facts.period.startYear, a.facts.period.startEra) -
    sortableYear(b.facts.period.startYear, b.facts.period.startEra)
);

const capitalPoints = items
  .filter((i) => i.entry)
  .flatMap((i) =>
    i.facts.capitals.map((c) => ({
      href: `/${lang}/davlatlar/${i.slug}`,
      stateTitle: i.entry!.data.title,
      name: c.name,
      lat: c.lat,
      lng: c.lng,
      category: i.facts.category,
    }))
  );

const chartItems = items
  .filter((i) => i.entry)
  .map((i) => ({ slug: i.slug, href: `/${lang}/davlatlar/${i.slug}`, title: i.entry!.data.title, facts: i.facts }));
---

<BaseLayout lang={lang!} title={t('nav.states')}>
  <PageHero lang={lang!} image="davlatlar" alt={t('hero.altStates')} title={t('nav.states')} lead={t('hero.statesLead')} focus="50% 45%" />
  <p class="mb-6 text-sm text-ink-muted">{t('states.sortedNote')}</p>

  <DidYouKnow
    lang={lang!}
    items={items
      .filter((i) => i.entry)
      .map((i) => ({ href: `/${lang}/davlatlar/${i.slug}`, title: i.entry!.data.title, facts: i.facts, cards: i.entry!.data.didYouKnow }))}
  />

  <StatesStats lang={lang!} items={chartItems} />

  <section class="mb-8" aria-labelledby="capitals-map-heading">
    <h2 id="capitals-map-heading" class="mb-3 text-lg font-semibold text-ink">{t('states.capitalsMapTitle')}</h2>
    <CapitalsMap lang={lang!} points={capitalPoints} />
  </section>

  <StatesGenealogy lang={lang!} items={chartItems} />

  {/* Toifa filtri: JavaScript'siz — radio guruhi + CSS :has() (global.css, .tb-filter). */}
  <div class="tb-filter">
    <fieldset class="mb-6">
      <legend class="sr-only">{t('states.filterLegend')}</legend>
      <div class="flex flex-wrap gap-2">
        {FILTERS.map((f) => (
          <label class="tb-filter-tab">
            <input type="radio" name="state-category" value={f.value} checked={f.value === 'hammasi'} class="sr-only" />
            <span>{f.label}</span>
            <span class="tb-filter-count tabular-nums">{f.count}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <StatesTimeline lang={lang!} items={chartItems} />

  <ul class="grid gap-4 sm:grid-cols-2">
    {items.map(({ slug, entry, isFallback, facts }, index) => entry && (
      <EntryCard
        lang={lang!}
        href={`/${lang}/davlatlar/${slug}`}
        title={entry.data.title}
        summary={entry.data.summary}
        isFallback={isFallback}
        index={index}
        category={facts.category}
      >
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-xs font-medium tabular-nums text-ink-muted">{formatPeriod(t, facts.period)}</span>
          <StateCategoryBadge lang={lang!} category={facts.category} />
        </div>
      </EntryCard>
    ))}
  </ul>
  </div>
</BaseLayout>
