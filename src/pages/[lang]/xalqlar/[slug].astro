---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import VerifiedBadge from '../../../components/VerifiedBadge.astro';
import TranslationNotice from '../../../components/TranslationNotice.astro';
import DisputedList from '../../../components/DisputedList.astro';
import SourcesList from '../../../components/SourcesList.astro';
import PeopleStatehood from '../../../components/peoples/PeopleStatehood.astro';
import Carousel, { type Slide } from '../../../components/gallery/Carousel.astro';
import galleryData from '../../../data/gallery.json';
import flags from '../../../data/flags.json';
import { locales } from '../../../i18n/locales';
import { createTranslator } from '../../../i18n/ui';

export async function getStaticPaths() {
  const facts = await getCollection('peopleFacts');
  return locales.flatMap((locale) =>
    facts.map((fact) => ({ params: { lang: locale.code, slug: fact.id } }))
  );
}

const { lang, slug } = Astro.params;
const t = createTranslator(lang!);

const localized = await getEntry('peoples', `${lang}/${slug}`);
const entry = localized ?? (await getEntry('peoples', `uz/${slug}`));

if (!entry) {
  return Astro.redirect(`/${lang}/xalqlar`);
}

const isFallback = !localized;
const facts = await getEntry(entry.data.factsId);
const { Content } = await render(entry);

const sourceEntries = facts
  ? await Promise.all(facts.data.sources.map((ref) => getEntry(ref)))
  : [];

const stateEntries = facts
  ? await Promise.all(
      facts.data.historicalStates.map(async (ref) => {
        const localizedState = await getEntry('states', `${lang}/${ref.id}`);
        return localizedState ?? (await getEntry('states', `uz/${ref.id}`));
      })
    )
  : [];

// Allomalar: xalq faktlaridagi ro'yxat + relatedPeoples orqali teskari bog'lanish.
const allScholarFacts = await getCollection('scholarFacts');
const scholarIds = [
  ...new Set([
    ...(facts?.data.scholars.map((r) => r.id) ?? []),
    ...allScholarFacts.filter((sf) => sf.data.relatedPeoples.some((r) => r.id === slug)).map((sf) => sf.id),
  ]),
];
const scholarEntries = await Promise.all(
  scholarIds.map(async (id) => (await getEntry('scholars', `${lang}/${id}`)) ?? (await getEntry('scholars', `uz/${id}`)))
);

// Karusel: obidalar (Commons), davlat gerbi va bayrog'i (statehood dan).
const galleryTexts = { ...(isFallback ? {} : ((await getEntry('peoples', `uz/${slug}`))?.data.galleryTexts ?? {})), ...(entry.data.galleryTexts ?? {}) };
const mainEntity = facts?.data.statehood?.entities[0]?.name ?? '';
const slides: Slide[] = [];
for (const g of (galleryData as Record<string, any[]>)[`peoples/${slug}`] ?? []) {
  const credit = g.sourceUrl ? { author: g.author, license: g.license, licenseUrl: g.licenseUrl, sourceUrl: g.sourceUrl } : undefined;
  if (g.kind === 'obida') slides.push({ kind: 'photo', src: g.src, width: g.width, height: g.height, caption: galleryTexts[g.id] ?? g.id, unescoYear: g.unescoYear, credit: credit! });
  else if (g.kind === 'gerb') slides.push({ kind: 'emblem', src: g.src, caption: t('gallery.emblem', { name: mainEntity }), credit });
  else if (g.kind === 'gerb-yoq') slides.push({ kind: 'note', caption: t('gallery.noEmblem') });
}
for (const e of facts?.data.statehood?.entities ?? []) {
  const f = e.flag ? flags[e.flag as keyof typeof flags] : undefined;
  if (f && slides.length > 0) slides.push({ kind: 'flag', src: f.file, caption: t('gallery.flag', { name: e.name }), credit: { author: 'Wikimedia Commons', license: 'Public domain', licenseUrl: null, sourceUrl: f.commons } });
}

const accentColor = facts?.data.accentColor;
const pattern = facts?.data.pattern ?? 'zigzag';
---

<BaseLayout lang={lang!} title={entry.data.title} description={entry.data.summary}>
  <div
    class="tb-people-banner relative -mx-4 mb-8 overflow-hidden px-6 py-10 shadow-lg sm:px-10 sm:py-14"
    style={accentColor
      ? `--people-accent: ${accentColor.light}; --people-accent-dark: ${accentColor.dark}; border-radius: 1.5rem;`
      : `background-image: var(--gradient-hero); border-radius: 1.5rem;`}
  >
    <div class={`absolute inset-0 tb-pattern-${pattern}`} style="color: #fff; opacity: 0.16;"></div>
    <div class="relative flex flex-wrap items-center gap-3">
      <h1 class="text-3xl font-extrabold tracking-tight text-white drop-shadow-sm sm:text-4xl">{entry.data.title}</h1>
      <VerifiedBadge lang={lang!} verified={facts?.data.verified ?? false} />
    </div>
    <p class="relative mt-3 max-w-2xl text-white/90">{entry.data.summary}</p>
  </div>

  {isFallback && <TranslationNotice lang={lang!} />}

  <Carousel lang={lang!} slides={slides} />

  {facts?.data.statehood && (
    <PeopleStatehood lang={lang!} statehood={facts.data.statehood} peopleFlag={facts.data.peopleFlag} />
  )}

  {facts && facts.data.population.length > 0 && (
    <section class="mb-6 rounded-xl border border-line bg-surface-alt p-5">
      <h2 class="mb-2 text-sm font-semibold uppercase tracking-wide text-ink-muted">
        {t('common.summary')}: {t('nav.peoples')}
      </h2>
      <ul class="text-sm text-ink">
        {facts.data.population.map((p) => (
          <li>
            {new Intl.NumberFormat(lang).format(p.value)} — {p.country} ({p.year})
          </li>
        ))}
      </ul>
    </section>
  )}

  <article class="prose prose-slate max-w-none dark:prose-invert">
    <Content />
  </article>

  {stateEntries.length > 0 && (
    <section class="mt-8">
      <h2 class="mb-3 text-lg font-semibold text-ink">{t('nav.states')}</h2>
      <ul class="flex flex-wrap gap-2">
        {stateEntries.map((s) => s && (
          <li>
            <a
              href={`/${lang}/davlatlar/${s.id.split('/').slice(1).join('/')}`}
              class="inline-block rounded-full border border-line bg-surface-alt px-3 py-1 text-sm text-ink transition-colors hover:border-brand/40 hover:text-brand"
            >
              {s.data.title}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {scholarEntries.length > 0 && (
    <section class="mt-8">
      <h2 class="mb-3 text-lg font-semibold text-ink">{t('nav.scholars')}</h2>
      <ul class="flex flex-wrap gap-2">
        {scholarEntries.map((s) => s && (
          <li>
            <a
              href={`/${lang}/allomalar/${s.id.split('/').slice(1).join('/')}`}
              class="inline-block rounded-full border border-line bg-surface-alt px-3 py-1 text-sm text-ink transition-colors hover:border-brand/40 hover:text-brand"
            >
              {s.data.title}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {facts && <DisputedList lang={lang!} topics={facts.data.disputed} />}

  <SourcesList lang={lang!} sources={sourceEntries} />
</BaseLayout>

<style>
  .tb-people-banner {
    background-color: var(--people-accent, var(--color-brand));
  }
  @media (prefers-color-scheme: dark) {
    .tb-people-banner {
      background-color: var(--people-accent-dark, var(--color-brand));
    }
  }
</style>
