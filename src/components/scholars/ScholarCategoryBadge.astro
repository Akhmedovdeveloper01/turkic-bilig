---
/** Allomaning turkiy dunyo bilan bog'liqlik toifasi belgisi (rang + matn). */
import { createTranslator } from '../../i18n/ui';

interface Props {
  lang: string;
  category: 'turkiy' | 'mintaqaviy' | 'munozarali';
}
const { lang, category } = Astro.props;
const t = createTranslator(lang);
const LABEL = {
  turkiy: t('scholars.categoryTurkiy'),
  mintaqaviy: t('scholars.categoryMintaqaviy'),
  munozarali: t('scholars.categoryMunozarali'),
};
const STYLE = {
  turkiy: 'border-cat-turkiy/40 bg-cat-turkiy/10 text-brand-dark dark:text-brand',
  mintaqaviy: 'border-cat-sulola/40 bg-gold-soft text-gold',
  munozarali: 'border-dashed border-cat-munozarali/50 bg-cat-munozarali/10 text-cat-munozarali',
};
---

<span class:list={['inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-medium', STYLE[category]]}>
  {LABEL[category]}
</span>
