---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OrnamentDivider from '../../components/OrnamentDivider.astro';
import { locales } from '../../i18n/locales';
import { createTranslator } from '../../i18n/ui';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { lang: locale.code } }));
}

const { lang } = Astro.params;
const t = createTranslator(lang!);
---

<BaseLayout lang={lang!}>
  <section class="mx-auto max-w-2xl text-center">
    <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-brand">
      {t('home.heroTagline')}
    </p>
    <h1 class="mb-4 text-4xl font-bold tracking-tight text-ink sm:text-5xl">{t('site.title')}</h1>
    <p class="text-lg text-ink-muted">{t('home.heroLead')}</p>
    <OrnamentDivider class="mx-auto mt-8 max-w-xs text-accent/40" />
  </section>

  <section class="mx-auto mt-12 grid max-w-4xl gap-5 sm:grid-cols-3">
    <a
      href={`/${lang}/xalqlar`}
      class="group rounded-2xl border border-line bg-surface-alt p-6 transition-colors hover:border-brand/40"
    >
      <svg viewBox="0 0 24 24" class="mb-4 h-8 w-8 text-brand" fill="none" stroke="currentColor" stroke-width="1.6">
        <circle cx="9" cy="8" r="3" /><circle cx="17" cy="9" r="2.4" />
        <path d="M3.5 19c.6-3 2.7-5 5.5-5s4.9 2 5.5 5M15 14.6c2.2.2 3.9 1.9 4.4 4.4" />
      </svg>
      <h2 class="mb-1 font-semibold text-ink group-hover:text-brand">{t('home.peoplesCardTitle')}</h2>
      <p class="text-sm text-ink-muted">{t('home.peoplesCardDesc')}</p>
    </a>

    <a
      href={`/${lang}/mavzular`}
      class="group rounded-2xl border border-line bg-surface-alt p-6 transition-colors hover:border-brand/40"
    >
      <svg viewBox="0 0 24 24" class="mb-4 h-8 w-8 text-brand" fill="none" stroke="currentColor" stroke-width="1.6">
        <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H19v15.5H6.5A2.5 2.5 0 0 0 4 21V5.5Z" />
        <path d="M4 18.5A2.5 2.5 0 0 1 6.5 16H19" />
      </svg>
      <h2 class="mb-1 font-semibold text-ink group-hover:text-brand">{t('home.topicsCardTitle')}</h2>
      <p class="text-sm text-ink-muted">{t('home.topicsCardDesc')}</p>
    </a>

    <div class="rounded-2xl border border-dashed border-line p-6 opacity-60">
      <svg viewBox="0 0 24 24" class="mb-4 h-8 w-8 text-ink-muted" fill="none" stroke="currentColor" stroke-width="1.6">
        <path d="M4 21V10l8-6 8 6v11M4 21h16M9 21v-6h6v6" />
      </svg>
      <h2 class="mb-1 font-semibold text-ink">{t('home.statesCardTitle')}</h2>
      <p class="text-sm text-ink-muted">{t('home.statesCardDesc')}</p>
    </div>
  </section>
</BaseLayout>
