---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import EntryCard from '../../../components/EntryCard.astro';
import { locales } from '../../../i18n/locales';
import { createTranslator } from '../../../i18n/ui';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { lang: locale.code } }));
}

const { lang } = Astro.params;
const t = createTranslator(lang!);

const facts = await getCollection('topicFacts');

const items = await Promise.all(
  facts.map(async (fact) => {
    const slug = fact.id;
    const localized = await getEntry('topics', `${lang}/${slug}`);
    const original = localized ?? (await getEntry('topics', `uz/${slug}`));
    return { slug, entry: original, isFallback: !localized };
  })
);
---

<BaseLayout lang={lang!} title={t('nav.topics')}>
  <PageHero lang={lang!} image="mavzular" alt={t('hero.altTopics')} title={t('nav.topics')} lead={t('hero.topicsLead')} fit="contain" />
  <ul class="grid gap-4 sm:grid-cols-2">
    {items.map(({ slug, entry, isFallback }, index) => entry && (
      <EntryCard
        lang={lang!}
        href={`/${lang}/mavzular/${slug}`}
        title={entry.data.title}
        summary={entry.data.summary}
        isFallback={isFallback}
        index={index}
      />
    ))}
  </ul>
</BaseLayout>
