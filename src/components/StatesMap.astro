---
/**
 * Poytaxt nuqtalarini ko'rsatuvchi interaktiv xarita (Leaflet).
 * Tarixiy CHEGARALAR emas, faqat poytaxt shahar(lar)ining geografik
 * joylashuvi ko'rsatiladi — chegara chizig'i uchun hali tekshirilgan
 * GeoJSON manba yo'q (ILMIY QOIDA 6), shahar koordinatasi esa bahssiz
 * geografik fakt.
 *
 * Marker sifatida saytning o'z logotip belgisi (neytral geometrik yulduz)
 * ishlatiladi — aksariyat bu yerdagi davlatlar (Usmonlidan tashqari)
 * zamonaviy ma'nodagi "bayroq"dan foydalanmagan, shu sababli har qanday
 * "sulola bayrog'i" tasviri hujjatlashtirilmagan/psevdotarixiy bo'lar edi
 * (ILMIY QOIDA 4).
 */
interface Point {
  href: string;
  stateTitle: string;
  name: string;
  lat: number;
  lng: number;
}
interface Props {
  points: Point[];
}
const { points } = Astro.props;
---

<div id="states-map" class="h-96 w-full overflow-hidden rounded-xl border border-line" data-points={JSON.stringify(points)}>
</div>


<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  interface Point {
    href: string;
    stateTitle: string;
    name: string;
    lat: number;
    lng: number;
  }

  const starIcon = L.divIcon({
    className: 'tb-map-marker',
    html: `<div class="tb-map-marker-inner"><svg viewBox="0 0 24 24" width="14" height="14"><rect x="5" y="5" width="14" height="14" fill="#fff" /><rect x="5" y="5" width="14" height="14" fill="#fff" transform="rotate(45 12 12)" /></svg></div>`,
    iconSize: [28, 28],
    iconAnchor: [14, 14],
    popupAnchor: [0, -16],
  });

  const el = document.getElementById('states-map');
  if (el) {
    const points: Point[] = JSON.parse(el.dataset.points || '[]');
    const map = L.map(el).setView([40, 65], 3);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      maxZoom: 12,
    }).addTo(map);

    const markers = points.map((p) => {
      const marker = L.marker([p.lat, p.lng], { icon: starIcon }).addTo(map);
      marker.bindPopup(`<a href="${p.href}">${p.stateTitle}</a><br>${p.name}`);
      return marker;
    });

    if (markers.length > 0) {
      const group = L.featureGroup(markers);
      map.fitBounds(group.getBounds().pad(0.3));
    }
  }
</script>
