---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { getLocale, defaultLocale } from '../i18n/locales';
import { SCRIPT_FONT_IMPORTS, SCRIPT_FONT_WEIGHT_IMPORTS } from '../i18n/fonts';
import { createTranslator } from '../i18n/ui';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import Logo from '../components/Logo.astro';
import OrnamentDivider from '../components/OrnamentDivider.astro';

interface Props {
  lang: string;
  title?: string;
  description?: string;
}

const { lang, title, description } = Astro.props;
const locale = getLocale(lang) ?? getLocale(defaultLocale)!;

// Faqat shu sahifaga kerakli skript uchun shrift yuklanadi.
await SCRIPT_FONT_IMPORTS[locale.script]();
await SCRIPT_FONT_WEIGHT_IMPORTS[locale.script]();

const t = createTranslator(locale.code);

// Asosiy bo'limlar — katta ekranda gorizontal menyu, kichik ekranda ochiladigan menyu.
const NAV = [
  { href: 'xalqlar', key: 'nav.peoples' },
  { href: 'davlatlar', key: 'nav.states' },
  { href: 'allomalar', key: 'nav.scholars' },
  { href: 'hukmdorlar', key: 'nav.rulers' },
  { href: 'mavzular', key: 'nav.topics' },
  { href: 'meros', key: 'nav.heritage' },
];
const section = Astro.url.pathname.split('/')[2] ?? '';
const pageTitle = title ? `${title} — ${t('site.title')}` : `${t('site.title')} — ${t('site.description')}`;
---

<html lang={locale.code} dir={locale.dir} style={`--font-sans: '${locale.font}', system-ui, sans-serif;`}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? t('site.description')} />
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-surface text-ink antialiased" style="font-family: var(--font-sans);">
    <header class="sticky top-0 z-40 border-b border-line bg-surface/90 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
        <a href={`/${locale.code}/`} class="group flex items-center gap-2 text-brand" transition:name="site-logo">
          <Logo class="h-6 w-6 transition-transform duration-500 group-hover:rotate-45" />
          <span class="text-lg font-semibold tracking-tight text-ink">{t('site.title')}</span>
        </a>
        <div class="flex items-center gap-2 lg:gap-5">
          <nav class="hidden items-center gap-5 lg:flex" aria-label={t('nav.main')}>
            {NAV.map((n) => (
              <a
                href={`/${locale.code}/${n.href}`}
                class:list={['tb-nav-link text-sm font-medium transition-colors hover:text-brand', section === n.href ? 'text-brand' : 'text-ink-muted']}
                aria-current={section === n.href ? 'page' : undefined}
              >
                {t(n.key)}
              </a>
            ))}
          </nav>
          <LanguageSwitcher currentLang={locale.code} />
          <details class="tb-mobile-nav tb-popover group lg:hidden">
            <summary
              class="flex h-10 cursor-pointer list-none items-center gap-1.5 rounded-full border border-brand/40 bg-brand/10 px-3.5 text-sm font-semibold text-brand-dark transition-colors hover:border-brand dark:text-brand [&::-webkit-details-marker]:hidden"
              aria-label={t('nav.menu')}
            >
              <svg viewBox="0 0 24 24" class="size-5 group-open:hidden" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path></svg>
              <svg viewBox="0 0 24 24" class="hidden size-5 group-open:block" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"></path></svg>
              <span>{t('nav.menu')}</span>
            </summary>
            <nav class="absolute inset-x-0 top-full border-b border-line bg-surface shadow-lg shadow-ink/5" aria-label={t('nav.main')}>
              <ul class="mx-auto max-w-6xl px-4 py-2">
                <li>
                  <a href={`/${locale.code}/`} class:list={['flex min-h-12 items-center rounded-lg px-3 text-base font-medium hover:bg-surface-alt', section === '' ? 'text-brand' : 'text-ink']} aria-current={section === '' ? 'page' : undefined}>
                    {t('nav.home')}
                  </a>
                </li>
                {NAV.map((n) => (
                  <li>
                    <a
                      href={`/${locale.code}/${n.href}`}
                      class:list={['flex min-h-12 items-center rounded-lg px-3 text-base font-medium hover:bg-surface-alt', section === n.href ? 'bg-surface-alt text-brand' : 'text-ink']}
                      aria-current={section === n.href ? 'page' : undefined}
                    >
                      {t(n.key)}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </details>
        </div>
      </div>
      <OrnamentDivider class="text-brand/25" />
    </header>
    <script>
      // Menyu va til tanlash oynasi: tashqariga bosilganda yoki Escape'da yopiladi,
      // bittasi ochilganda ikkinchisi yopiladi.
      const popovers = () => [...document.querySelectorAll<HTMLDetailsElement>('details.tb-popover')];
      document.addEventListener('click', (e) => {
        for (const d of popovers()) if (d.open && !d.contains(e.target as Node)) d.open = false;
      });
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        for (const d of popovers()) if (d.open) { d.open = false; d.querySelector('summary')?.focus(); }
      });
      document.addEventListener('toggle', (e) => {
        const d = e.target as HTMLDetailsElement;
        if (d.classList?.contains('tb-popover') && d.open) for (const o of popovers()) if (o !== d) o.open = false;
      }, true);
    </script>
    <main class="mx-auto max-w-6xl px-4 py-10">
      <slot />
    </main>
    <footer class="mt-16">
      <OrnamentDivider class="text-line" />
      <div class="mx-auto max-w-6xl px-4 py-8 text-center text-sm text-ink-muted">
        <p class="flex items-center justify-center gap-1.5">
          <Logo class="h-4 w-4 text-brand" />
          Turkic Bilig — {t('footer.rights')}
        </p>
      </div>
    </footer>

    <script>
      function tbSetupReveal() {
        const els = document.querySelectorAll('.tb-reveal:not(.tb-revealed)');
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('tb-revealed'));
          return;
        }
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('tb-revealed');
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15 }
        );
        els.forEach((el) => observer.observe(el));
      }
      document.addEventListener('astro:page-load', tbSetupReveal);
    </script>
  </body>
</html>
