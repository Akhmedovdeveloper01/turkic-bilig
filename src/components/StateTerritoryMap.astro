---
/**
 * Bitta davlatning poytaxt(lar)i va TAXMINIY hudud shaklini ko'rsatuvchi
 * xarita (Leaflet).
 *
 * `extentPoints` — aniq tarixiy CHEGARA emas. Bunga hali tekshirilgan
 * GeoJSON manba yo'q (ILMIY QOIDA 6). Bu faqat davlat sahifasidagi matnda
 * tasvirlangan umumiy yoyilish yo'nalishini ko'rsatuvchi sxematik
 * ko'pburchak — shu sababli har doim aniq ogohlantirish matni bilan
 * birga chiqadi (chaqiruvchi sahifada) va poligonning o'zi ham xira,
 * shaffof uslubda chiziladi.
 */
interface Point {
  name: string;
  lat: number;
  lng: number;
}
interface Props {
  capitals: Point[];
  extentPoints: Point[];
  popupText: string;
}
const { capitals, extentPoints, popupText } = Astro.props;
---

<div
  id="territory-map"
  class="h-80 w-full overflow-hidden rounded-xl border border-line"
  data-capitals={JSON.stringify(capitals)}
  data-extent={JSON.stringify(extentPoints)}
  data-popup={popupText}
>
</div>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  interface Point {
    name: string;
    lat: number;
    lng: number;
  }

  const starIcon = L.divIcon({
    className: 'tb-map-marker',
    html: `<div class="tb-map-marker-inner"><svg viewBox="0 0 24 24" width="14" height="14"><rect x="5" y="5" width="14" height="14" fill="#fff" /><rect x="5" y="5" width="14" height="14" fill="#fff" transform="rotate(45 12 12)" /></svg></div>`,
    iconSize: [28, 28],
    iconAnchor: [14, 14],
    popupAnchor: [0, -16],
  });

  const el = document.getElementById('territory-map');
  if (el) {
    const capitals: Point[] = JSON.parse(el.dataset.capitals || '[]');
    const extentPoints: Point[] = JSON.parse(el.dataset.extent || '[]');
    const popupText = el.dataset.popup || '';

    const map = L.map(el).setView([40, 60], 3);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      maxZoom: 10,
    }).addTo(map);

    const allPoints: [number, number][] = [];

    if (extentPoints.length >= 3) {
      const polygon = L.polygon(
        extentPoints.map((p) => [p.lat, p.lng]),
        { color: '#c1553a', weight: 1.5, opacity: 0.6, fillColor: '#c1553a', fillOpacity: 0.15, dashArray: '5 5' }
      ).addTo(map);
      polygon.bindPopup(popupText);
      extentPoints.forEach((p) => allPoints.push([p.lat, p.lng]));
    }

    for (const c of capitals) {
      L.marker([c.lat, c.lng], { icon: starIcon }).addTo(map).bindPopup(c.name);
      allPoints.push([c.lat, c.lng]);
    }

    if (allPoints.length > 0) {
      map.fitBounds(L.latLngBounds(allPoints).pad(0.2));
    }
  }
</script>
