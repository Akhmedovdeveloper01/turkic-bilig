---
/** Hukmdor yoki sarkardaning roli belgisi. */
import { createTranslator } from '../../i18n/ui';

interface Props {
  lang: string;
  role: 'asoschi' | 'hukmdor' | 'sarkarda';
}
const { lang, role } = Astro.props;
const t = createTranslator(lang);
---

<span class="inline-flex items-center rounded-full border border-line bg-surface px-2.5 py-0.5 text-xs font-medium text-ink-muted">
  {t(`rulers.role.${role}`)}
</span>
