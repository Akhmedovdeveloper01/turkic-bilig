---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import VerifiedBadge from '../../../components/VerifiedBadge.astro';
import TranslationNotice from '../../../components/TranslationNotice.astro';
import DisputedList from '../../../components/DisputedList.astro';
import SourcesList from '../../../components/SourcesList.astro';
import StateMap from '../../../components/map/StateMap.astro';
import StateSymbols from '../../../components/symbols/StateSymbols.astro';
import { getStateGeoJSON } from '../../../data/geo';
import { locales } from '../../../i18n/locales';
import { createTranslator } from '../../../i18n/ui';
import { formatPeriod } from '../../../i18n/years';
import StateCategoryBadge from '../../../components/states/StateCategoryBadge.astro';

export async function getStaticPaths() {
  const facts = await getCollection('stateFacts');
  return locales.flatMap((locale) =>
    facts.map((fact) => ({ params: { lang: locale.code, slug: fact.id } }))
  );
}

const { lang, slug } = Astro.params;
const t = createTranslator(lang!);

const localized = await getEntry('states', `${lang}/${slug}`);
const entry = localized ?? (await getEntry('states', `uz/${slug}`));

if (!entry) {
  return Astro.redirect(`/${lang}/davlatlar`);
}

const isFallback = !localized;
const sourceEntry = isFallback ? entry : await getEntry('states', `uz/${slug}`);
const facts = await getEntry(entry.data.factsId);
const { Content } = await render(entry);

const sourceEntries = facts
  ? await Promise.all(facts.data.sources.map((ref) => getEntry(ref)))
  : [];

const allScholarFacts = await getCollection('scholarFacts');
const relatedScholarFacts = allScholarFacts.filter((sf) =>
  sf.data.relatedStates.some((ref) => ref.id === slug)
);
const scholarEntries = await Promise.all(
  relatedScholarFacts.map(async (sf) => {
    const localizedScholar = await getEntry('scholars', `${lang}/${sf.id}`);
    return localizedScholar ?? (await getEntry('scholars', `uz/${sf.id}`));
  })
);


const stateGeoJSON =
  facts?.data.mapYear !== undefined ? getStateGeoJSON(slug!, facts.data.mapYear) : undefined;
---

<BaseLayout lang={lang!} title={entry.data.title} description={entry.data.summary}>
  <div class="mb-4 flex flex-wrap items-center gap-2">
    <h1 class="text-3xl font-bold tracking-tight text-ink">{entry.data.title}</h1>
    <VerifiedBadge lang={lang!} verified={facts?.data.verified ?? false} />
    {facts && <StateCategoryBadge lang={lang!} category={facts.data.category} />}
  </div>

  {isFallback && <TranslationNotice lang={lang!} />}

  <p class="mb-6 text-lg text-ink-muted">{entry.data.summary}</p>

  {facts && (
    <section class="mb-6 flex flex-wrap gap-6 rounded-xl border border-line bg-surface-alt p-5 text-sm">
      <div>
        <p class="font-semibold uppercase tracking-wide text-ink-muted">{t('common.period')}</p>
        <p class="text-ink">
          {formatPeriod(t, facts.data.period)}
        </p>
      </div>
      {facts.data.capital && (
        <div>
          <p class="font-semibold uppercase tracking-wide text-ink-muted">{t('common.capital')}</p>
          <p class="text-ink">{facts.data.capital}</p>
        </div>
      )}
    </section>
  )}

  {facts && (
    <StateSymbols
      lang={lang!}
      facts={facts.data}
      texts={entry.data.symbolTexts}
      fallbackTexts={sourceEntry?.data.symbolTexts}
    />
  )}

  {stateGeoJSON && (
    <section class="mb-8">
      <h2 class="mb-1 text-lg font-semibold text-ink">{t('states.territoryMapTitle')}</h2>
      <p class="mb-3 text-xs text-ink-muted">{t('states.territoryMapNote')}</p>
      <StateMap geojson={stateGeoJSON} mapColor={facts?.data.mapColor} lang={lang!} title={entry.data.title} />
    </section>
  )}

  <article class="prose prose-slate max-w-none dark:prose-invert">
    <Content />
  </article>

  {scholarEntries.length > 0 && (
    <section class="mt-8">
      <h2 class="mb-3 text-lg font-semibold text-ink">{t('nav.scholars')}</h2>
      <ul class="flex flex-wrap gap-2">
        {scholarEntries.map((s) => s && (
          <li>
            <a
              href={`/${lang}/allomalar/${s.id.split('/').slice(1).join('/')}`}
              class="inline-block rounded-full border border-line bg-surface-alt px-3 py-1 text-sm text-ink transition-colors hover:border-brand/40 hover:text-brand"
            >
              {s.data.title}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {facts && <DisputedList lang={lang!} topics={facts.data.disputed} />}

  <SourcesList lang={lang!} sources={sourceEntries} />
</BaseLayout>
