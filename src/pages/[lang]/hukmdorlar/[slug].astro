---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import VerifiedBadge from '../../../components/VerifiedBadge.astro';
import TranslationNotice from '../../../components/TranslationNotice.astro';
import DisputedList from '../../../components/DisputedList.astro';
import SourcesList from '../../../components/SourcesList.astro';
import ScholarPortrait from '../../../components/scholars/ScholarPortrait.astro';
import ScholarCategoryBadge from '../../../components/scholars/ScholarCategoryBadge.astro';
import RoleBadge from '../../../components/rulers/RoleBadge.astro';
import ContributionsBlock from '../../../components/heritage/ContributionsBlock.astro';
import PersonDynasties from '../../../components/rulers/PersonDynasties.astro';
import { locales } from '../../../i18n/locales';
import { createTranslator } from '../../../i18n/ui';
import { formatCentury, formatYear } from '../../../i18n/years';

export async function getStaticPaths() {
  // Allomalar ro'yxatidagi shaxslar (scholar) uchun alohida sahifa yaratilmaydi.
  const facts = (await getCollection('rulerFacts')).filter((f) => !f.data.scholar);
  return locales.flatMap((locale) => facts.map((fact) => ({ params: { lang: locale.code, slug: fact.id } })));
}

const { lang, slug } = Astro.params;
const t = createTranslator(lang!);

const localized = await getEntry('rulers', `${lang}/${slug}`);
const entry = localized ?? (await getEntry('rulers', `uz/${slug}`));
if (!entry) return Astro.redirect(`/${lang}/hukmdorlar`);

const isFallback = !localized;
const facts = (await getEntry(entry.data.factsId))!;
const f = facts.data;
const { Content } = await render(entry);
const sourceEntries = await Promise.all(f.sources.map((ref) => getEntry(ref)));

const stateTitle = async (id: string) =>
  ((await getEntry('states', `${lang}/${id}`)) ?? (await getEntry('states', `uz/${id}`)))?.data.title ?? id;

const reigns = await Promise.all(
  f.reigns.map(async (r) => ({
    state: r.state ? { slug: r.state.id, title: await stateTitle(r.state.id) } : null,
    period: `${r.uncertain ? '≈ ' : ''}${formatYear(t, r.from, r.fromEra)} – ${formatYear(t, r.to, r.toEra)}`,
  }))
);
const events = f.events
  .map((e) => ({ ...e, text: entry.data.eventTexts[e.id] }))
  .filter((e) => e.text);

const birth = f.birthYear !== undefined ? formatYear(t, f.birthYear, f.birthEra) : null;
const death = f.deathYear !== undefined ? formatYear(t, f.deathYear, f.deathEra) : null;
const century = !birth && !death && f.century !== undefined ? formatCentury(t, f.century) : null;
---

<BaseLayout lang={lang!} title={entry.data.title} description={entry.data.summary}>
  <div class="mb-4 flex flex-wrap items-center gap-2">
    <h1 class="text-3xl font-bold tracking-tight text-ink">{entry.data.title}</h1>
    <VerifiedBadge lang={lang!} verified={f.verified} />
    {f.roles.map((r) => <RoleBadge lang={lang!} role={r} />)}
    <ScholarCategoryBadge lang={lang!} category={f.category} kind="ruler" />
  </div>

  {isFallback && <TranslationNotice lang={lang!} />}

  {f.portrait && <ScholarPortrait lang={lang!} name={entry.data.title} portrait={f.portrait} />}

  <p class="mb-6 text-lg text-ink-muted">{entry.data.summary}</p>

  <section class="mb-6 flex flex-wrap gap-6 rounded-xl border border-line bg-surface-alt p-5 text-sm">
    {(birth || death || century) && (
      <div>
        <p class="font-semibold uppercase tracking-wide text-ink-muted">{t('common.period')}</p>
        <p class="text-ink">
          {century ?? `${birth ?? '?'} — ${death ?? '?'}`}
          {f.datesUncertain && <span class="ms-1 text-xs text-gold">({t('common.approximate')})</span>}
        </p>
      </div>
    )}
    {reigns.length > 0 && (
      <div>
        <p class="font-semibold uppercase tracking-wide text-ink-muted">{t('rulers.reigns')}</p>
        <ul class="text-ink">
          {reigns.map((r) => (
            <li>
              <span class="tabular-nums">{r.period}</span>
              {r.state && (
                <>
                  {' · '}
                  <a href={`/${lang}/davlatlar/${r.state.slug}`} class="text-brand hover:underline">{r.state.title}</a>
                </>
              )}
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>

  {events.length > 0 && (
    <section class="mb-8" aria-labelledby="ruler-events-title">
      <h2 id="ruler-events-title" class="mb-3 text-lg font-semibold text-ink">{t('rulers.events')}</h2>
      <ol class="relative space-y-3 border-s border-line ps-5">
        {events.map((e) => (
          <li class="relative">
            <span class="absolute -start-[1.6rem] top-1.5 h-2.5 w-2.5 rounded-full border-2 border-surface bg-brand" aria-hidden="true"></span>
            <p class="text-xs text-ink-muted">
              <span class="font-semibold tabular-nums text-ink">{e.uncertain ? '≈ ' : ''}{formatYear(t, e.year, e.era)}</span>
              {' · '}{t(`rulers.event.${e.kind}`)}
            </p>
            <p class="text-sm text-ink">{e.text}</p>
          </li>
        ))}
      </ol>
    </section>
  )}

  <article class="prose prose-slate max-w-none dark:prose-invert">
    <Content />
  </article>
  <div class="clear-both"></div>

  <PersonDynasties lang={lang!} ruler={slug} />

  <ContributionsBlock lang={lang!} ruler={slug} />

  <DisputedList lang={lang!} topics={f.disputed} />

  <SourcesList lang={lang!} sources={sourceEntries} />
</BaseLayout>
