---
/**
 * "Bilasizmi?" kartochkalari — davlat sahifalaridagi `didYouKnow` faktlari
 * (har biri manbaga bog'langan). Gorizontal aylantiriladigan qator
 * (scroll-snap), JavaScript'siz; klaviatura bilan ham aylantiriladi.
 */
import { getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { createTranslator } from '../../i18n/ui';

interface Item {
  href: string;
  title: string;
  facts: CollectionEntry<'stateFacts'>['data'];
  cards: CollectionEntry<'states'>['data']['didYouKnow'];
}
interface Props {
  lang: string;
  items: Item[];
}
const { lang, items } = Astro.props;
const t = createTranslator(lang);

const cards = await Promise.all(
  items.flatMap((i) =>
    i.cards.map(async (c) => {
      const sources = (await Promise.all(c.sourceIds.map((r) => getEntry(r)))).filter((s) => s !== undefined);
      return {
        text: c.text,
        href: i.href,
        stateTitle: i.title,
        category: i.facts.category,
        source: sources.map((s) => `${s.data.author}${s.data.year ? ` (${s.data.year})` : ''}`).join('; '),
      };
    })
  )
);
---

{cards.length > 0 && (
  <section class="mb-8" aria-labelledby="did-you-know-title">
    <div class="mb-3 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h2 id="did-you-know-title" class="flex items-center gap-2 text-lg font-semibold text-ink">
        <svg viewBox="0 0 24 24" class="h-5 w-5 text-gold" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.6 10.8c.6.5 1 1.2 1.1 2l.1.2h4.8l.1-.2c.1-.8.5-1.5 1.1-2A6 6 0 0 0 12 3Z" stroke-linejoin="round"></path>
        </svg>
        {t('states.didYouKnowTitle')}
      </h2>
      <p class="text-xs text-ink-muted">{t('states.didYouKnowNote', { n: String(cards.length) })}</p>
    </div>

    <ul
      class="tb-dyk -mx-4 flex snap-x snap-mandatory gap-3 overflow-x-auto scroll-px-4 px-4 pb-3"
      tabindex="0"
      aria-label={t('states.didYouKnowRegion')}
    >
      {cards.map((c) => (
        <li class="flex w-[17rem] shrink-0 snap-start flex-col rounded-xl border border-line bg-surface-alt p-4 sm:w-[19rem]">
          <span class:list={['mb-3 block h-1 w-10 rounded-full', `tb-tl-${c.category === 'turkiy-sulola' ? 'sulola' : c.category}`]} aria-hidden="true"></span>
          <p class="flex-1 text-sm leading-relaxed text-ink">{c.text}</p>
          <a href={c.href} class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-brand hover:underline">
            {c.stateTitle}
            <span aria-hidden="true" class="rtl:-scale-x-100">→</span>
          </a>
          <p class="mt-1 text-[0.7rem] text-ink-muted">{t('states.symbolSource')}: {c.source}</p>
        </li>
      ))}
    </ul>
  </section>
)}
