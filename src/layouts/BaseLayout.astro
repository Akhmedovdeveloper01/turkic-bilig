---
import '../styles/global.css';
import { getLocale, defaultLocale } from '../i18n/locales';
import { SCRIPT_FONT_IMPORTS, SCRIPT_FONT_WEIGHT_IMPORTS } from '../i18n/fonts';
import { createTranslator } from '../i18n/ui';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import Logo from '../components/Logo.astro';
import OrnamentDivider from '../components/OrnamentDivider.astro';

interface Props {
  lang: string;
  title?: string;
  description?: string;
}

const { lang, title, description } = Astro.props;
const locale = getLocale(lang) ?? getLocale(defaultLocale)!;

// Faqat shu sahifaga kerakli skript uchun shrift yuklanadi.
await SCRIPT_FONT_IMPORTS[locale.script]();
await SCRIPT_FONT_WEIGHT_IMPORTS[locale.script]();

const t = createTranslator(locale.code);
const pageTitle = title ? `${title} — ${t('site.title')}` : `${t('site.title')} — ${t('site.description')}`;
---

<html lang={locale.code} dir={locale.dir} style={`--font-sans: '${locale.font}', system-ui, sans-serif;`}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? t('site.description')} />
  </head>
  <body class="min-h-screen bg-surface text-ink antialiased" style="font-family: var(--font-sans);">
    <header class="sticky top-0 z-40 border-b border-line bg-surface/90 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
        <a href={`/${locale.code}/`} class="flex items-center gap-2 text-brand">
          <Logo class="h-6 w-6" />
          <span class="text-lg font-semibold tracking-tight text-ink">{t('site.title')}</span>
        </a>
        <nav class="flex items-center gap-5">
          <a href={`/${locale.code}/xalqlar`} class="hidden text-sm font-medium text-ink-muted transition-colors hover:text-brand sm:inline">
            {t('nav.peoples')}
          </a>
          <a href={`/${locale.code}/davlatlar`} class="hidden text-sm font-medium text-ink-muted transition-colors hover:text-brand sm:inline">
            {t('nav.states')}
          </a>
          <a href={`/${locale.code}/mavzular`} class="hidden text-sm font-medium text-ink-muted transition-colors hover:text-brand sm:inline">
            {t('nav.topics')}
          </a>
          <LanguageSwitcher currentLang={locale.code} />
        </nav>
      </div>
      <OrnamentDivider class="text-brand/25" />
    </header>
    <main class="mx-auto max-w-6xl px-4 py-10">
      <slot />
    </main>
    <footer class="mt-16">
      <OrnamentDivider class="text-line" />
      <div class="mx-auto max-w-6xl px-4 py-8 text-center text-sm text-ink-muted">
        <p class="flex items-center justify-center gap-1.5">
          <Logo class="h-4 w-4 text-brand" />
          Turkic Bilig — {t('footer.rights')}
        </p>
      </div>
    </footer>
  </body>
</html>
