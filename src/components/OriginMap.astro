---
/**
 * Turkiy xalqlarning gipotetik ilk vatani va bugungi asosiy joylashuvini
 * ko'rsatuvchi xarita — davlat xaritalari (map/StateMap.astro) bilan bir xil
 * uslubda, build vaqtida chiziladigan statik SVG (JavaScript'siz).
 *
 * Ikkita narsa ataylab aniq ajratilgan:
 * 1. "Gipotetik ilk vatan" — bitta taxminiy nuqta, ilmiy gipoteza sifatida
 *    belgilangan (ILMIY QOIDA 3: konsensus va munozara ajratiladi). Atrofidagi
 *    uzuq halqa aniq hudud emas, faqat noaniqlikni bildiradi.
 * 2. Har bir xalqning bugungi asosiy joylashuvi — bahssiz geografik fakt.
 * Ular orasidagi chiziqlar SXEMATIK — aniq tarixiy ko'chish yo'li yoki
 * marshrut emas, faqat kelib chiqish bilan bugungi joylashuv orasidagi
 * umumiy bog'liqlikni ko'rsatadi.
 */
import type { FeatureCollection } from 'geojson';
import { createProjection, graticulePath, landPath } from '../data/geo/basemap';
import { placeLabels } from '../data/geo/labels';
import { createTranslator } from '../i18n/ui';

interface Point {
  href?: string;
  name: string;
  lat: number;
  lng: number;
}
interface Props {
  lang: string;
  homeland: Point;
  peoples: Point[];
}
const { lang, homeland, peoples } = Astro.props;
const t = createTranslator(lang);

const fc: FeatureCollection = {
  type: 'FeatureCollection',
  features: [homeland, ...peoples].map((p) => ({
    type: 'Feature',
    properties: {},
    geometry: { type: 'Point', coordinates: [p.lng, p.lat] },
  })),
};
// Faqat nuqtalar bo'lgani uchun chekka kengroq — chetdagi nomlarga joy qolsin.
const proj = createProjection(fc, { lon: 0.06, lat: 0.12 });
const land = landPath(proj);
const grid = graticulePath(proj);

const [hx, hy] = proj.project([homeland.lng, homeland.lat]);

// Ilk vatandan har bir xalqqa egri (sxematik) chiziq: boshlanish va oxir
// orasidagi o'rta nuqta chiziqqa perpendikulyar yo'nalishda biroz suriladi.
const links = peoples.map((p) => {
  const [x, y] = proj.project([p.lng, p.lat]);
  const mx = (hx + x) / 2;
  const my = (hy + y) / 2;
  const dx = x - hx;
  const dy = y - hy;
  const cx = mx - dy * 0.18;
  const cy = my + dx * 0.18;
  return `M${hx.toFixed(1)} ${hy.toFixed(1)}Q${cx.toFixed(1)} ${cy.toFixed(1)} ${x.toFixed(1)} ${y.toFixed(1)}`;
});

const rawPoints = [
  { ...homeland, homeland: true, label: homeland.name.split(' (')[0] },
  ...peoples.map((p) => ({ ...p, homeland: false, label: p.name })),
].map((p) => {
  const [x, y] = proj.project([p.lng, p.lat]);
  return { ...p, x, y };
});
// Zich xarita: yorliq joyi mobil va desktop uchun alohida hisoblanadi; joy
// topilmagan yorliq yashiriladi (nuqta qoladi, nomi sarlavhada — title).
const mobile = placeLabels(rawPoints, proj.width, proj.height, { dropOnCollision: true });
const desktop = placeLabels(rawPoints, proj.width, proj.height, { renderWidth: 760, charWidth: 7, dropOnCollision: true });
const points = rawPoints.map((p, i) => ({
  ...p,
  left: mobile[i].left,
  top: mobile[i].top,
  labels: [
    { place: mobile[i].place, cls: 'sm:hidden' },
    { place: desktop[i].place, cls: 'hidden sm:block' },
  ].filter((l) => l.place),
}));
---

<figure class="not-prose">
  <div class="overflow-x-auto rounded-xl border border-line" tabindex="0" role="region" aria-label={t('peoples.originMapTitle')}>
  <div class="relative min-w-[36rem] overflow-hidden bg-map-sea [container-type:inline-size]">
    <svg viewBox={`0 0 ${proj.width} ${proj.height}`} class="block h-auto w-full" role="img" aria-labelledby="origin-map-title">
      <title id="origin-map-title">{t('peoples.originMapTitle')}</title>
      <rect width={proj.width} height={proj.height} fill="var(--color-map-sea)"></rect>
      <path
        d={grid}
        fill="none"
        stroke="var(--color-map-grid)"
        stroke-width="0.75"
        stroke-dasharray="2 5"
        vector-effect="non-scaling-stroke"
      ></path>
      <path
        d={land}
        fill="var(--color-map-land)"
        stroke="var(--color-map-coast)"
        stroke-width="0.9"
        stroke-linejoin="round"
        vector-effect="non-scaling-stroke"
      ></path>

      <circle
        cx={hx}
        cy={hy}
        r="46"
        fill="var(--color-accent)"
        fill-opacity="0.1"
        stroke="var(--color-accent)"
        stroke-width="1.5"
        stroke-dasharray="4 4"
        vector-effect="non-scaling-stroke"
      ></circle>

      <g fill="none" stroke="var(--color-accent)" stroke-width="1.6" stroke-dasharray="5 6" stroke-linecap="round" stroke-opacity="0.75">
        {links.map((d) => <path d={d} vector-effect="non-scaling-stroke"></path>)}
      </g>
    </svg>

    {/* Nuqta va yorliqlar qatlami. Geografik joylashuv RTL'da ko'zguli
        aylanmaydi, shuning uchun bu yerda ataylab fizik left/top ishlatiladi. */}
    <div class="pointer-events-none absolute inset-0">
      {points.map((p) => (
        <div class="absolute h-0 w-0" style={`left:${p.left}%;top:${p.top}%`}>
          <span class:list={['tb-pt', p.homeland ? 'tb-pt-homeland' : 'tb-pt-people']} title={p.name} aria-hidden="true"></span>
          {p.labels.map((l) =>
            p.href ? (
              <a
                href={p.href}
                class:list={[
                  'tb-pt-label pointer-events-auto underline-offset-2 hover:text-brand hover:underline',
                  `tb-pt-label-${l.place}`,
                  l.cls,
                  p.homeland && 'font-bold',
                ]}
              >
                {p.label}
              </a>
            ) : (
              <span class:list={['tb-pt-label', `tb-pt-label-${l.place}`, l.cls, p.homeland && 'font-bold']}>{p.label}</span>
            )
          )}
        </div>
      ))}
    </div>
  </div>
  </div>
  <figcaption class="mt-2 text-[0.7rem] text-ink-muted">{t('states.basemapCredit')}</figcaption>
</figure>
