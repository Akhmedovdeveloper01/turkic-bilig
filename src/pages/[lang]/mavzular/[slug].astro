---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import VerifiedBadge from '../../../components/VerifiedBadge.astro';
import TranslationNotice from '../../../components/TranslationNotice.astro';
import DisputedList from '../../../components/DisputedList.astro';
import SourcesList from '../../../components/SourcesList.astro';
import { locales, getLocale } from '../../../i18n/locales';
import { createTranslator } from '../../../i18n/ui';
import languagesData from '../../../data/languages.json';
import StatesMap from '../../../components/StatesMap.astro';

export async function getStaticPaths() {
  const facts = await getCollection('topicFacts');
  return locales.flatMap((locale) =>
    facts.map((fact) => ({ params: { lang: locale.code, slug: fact.id } }))
  );
}

const { lang, slug } = Astro.params;
const t = createTranslator(lang!);

const localized = await getEntry('topics', `${lang}/${slug}`);
const entry = localized ?? (await getEntry('topics', `uz/${slug}`));

if (!entry) {
  return Astro.redirect(`/${lang}/mavzular`);
}

const isFallback = !localized;
const facts = await getEntry(entry.data.factsId);
const { Content } = await render(entry);

const sourceEntries = facts
  ? await Promise.all(facts.data.sources.map((ref) => getEntry(ref)))
  : [];

const showLanguageBranches = facts?.data.category === 'til-tasnifi';

const showStatesMap = facts?.data.category === 'xronologiya';
let mapPoints: { href: string; stateTitle: string; name: string; lat: number; lng: number }[] = [];
if (showStatesMap) {
  const allStateFacts = await getCollection('stateFacts');
  const nested = await Promise.all(
    allStateFacts.map(async (sf) => {
      const localizedState = await getEntry('states', `${lang}/${sf.id}`);
      const stateEntry = localizedState ?? (await getEntry('states', `uz/${sf.id}`));
      if (!stateEntry) return [];
      return sf.data.capitals.map((c) => ({
        href: `/${lang}/davlatlar/${sf.id}`,
        stateTitle: stateEntry.data.title,
        name: c.name,
        lat: c.lat,
        lng: c.lng,
      }));
    })
  );
  mapPoints = nested.flat();
}
---

<BaseLayout lang={lang!} title={entry.data.title} description={entry.data.summary}>
  <div class="mb-4 flex flex-wrap items-center gap-2">
    <h1 class="text-3xl font-bold tracking-tight text-ink">{entry.data.title}</h1>
    <VerifiedBadge lang={lang!} verified={facts?.data.verified ?? false} />
  </div>

  {isFallback && <TranslationNotice lang={lang!} />}

  <p class="mb-6 text-lg text-ink-muted">{entry.data.summary}</p>

  <article class="prose prose-slate max-w-none dark:prose-invert">
    <Content />
  </article>

  {showStatesMap && mapPoints.length > 0 && (
    <section class="mt-8">
      <h2 class="mb-1 text-lg font-semibold text-ink">{t('topics.capitalsMapTitle')}</h2>
      <p class="mb-3 text-xs text-ink-muted">{t('topics.capitalsMapNote')}</p>
      <StatesMap points={mapPoints} />
    </section>
  )}

  {showLanguageBranches && (
    <section class="mt-8 rounded-xl border border-line bg-surface-alt p-5">
      <h2 class="mb-3 text-lg font-semibold text-ink">{t('nav.topics')}: {entry.data.title}</h2>
      {!languagesData.verified && (
        <p class="mb-3 text-xs text-gold">{languagesData.note}</p>
      )}
      <div class="grid gap-4 sm:grid-cols-2">
        {languagesData.branches.map((branch) => (
          <div>
            <h3 class="font-semibold text-ink">{branch.name}</h3>
            <ul class="mt-1 list-disc ps-5 text-sm text-ink-muted">
              {branch.languages.map((code) => {
                const l = getLocale(code);
                return l && <li>{l.endonym}</li>;
              })}
              {branch.languages.length === 0 && <li class="italic">—</li>}
            </ul>
          </div>
        ))}
      </div>
    </section>
  )}

  {facts && <DisputedList lang={lang!} topics={facts.data.disputed} />}

  <SourcesList lang={lang!} sources={sourceEntries} />
</BaseLayout>
