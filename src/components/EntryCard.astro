---
import { createTranslator } from '../i18n/ui';
import { getLocale, defaultLocale } from '../i18n/locales';

interface Props {
  lang: string;
  href: string;
  title: string;
  summary: string;
  isFallback: boolean;
}
const { lang, href, title, summary, isFallback } = Astro.props;
const t = createTranslator(lang);
const endonym = (getLocale(lang) ?? getLocale(defaultLocale)!).endonym;
---

<li class="group rounded-xl border border-line bg-surface-alt p-5 transition-colors hover:border-brand/40">
  <a href={href} class="text-lg font-semibold text-ink group-hover:text-brand">
    {title}
  </a>
  <p class="mt-1.5 text-sm text-ink-muted">{summary}</p>
  {isFallback && (
    <p class="mt-3 text-xs text-gold">{t('translation.notTranslated', { lang: endonym })}</p>
  )}
</li>
