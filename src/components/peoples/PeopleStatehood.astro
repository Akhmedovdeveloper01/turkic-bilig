---
/**
 * Xalq sahifasidagi "Davlatchilik" bloki: holat, davlat tuzilmasi va uning
 * rasmiy bayrog'i, shuningdek (bo'lsa) xalqning o'z etnik bayrog'i —
 * davlat bayrog'idan aniq ajratilgan holda va izoh bilan.
 */
import { getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { createTranslator } from '../../i18n/ui';
import StatehoodBadge from './StatehoodBadge.astro';
import flags from '../../data/flags.json';

type Facts = CollectionEntry<'peopleFacts'>['data'];
interface Props {
  lang: string;
  statehood: NonNullable<Facts['statehood']>;
  peopleFlag?: Facts['peopleFlag'];
}
const { lang, statehood, peopleFlag } = Astro.props;
const t = createTranslator(lang);

const flagOf = (key?: string) => (key ? flags[key as keyof typeof flags] : undefined);

const sourceLine = async (refs: { id: string; collection: 'sources' }[]) =>
  (await Promise.all(refs.map((r) => getEntry(r))))
    .filter((s) => s !== undefined)
    .map((s) => s.data.title)
    .join('; ');

const statehoodSources = await sourceLine(statehood.sourceIds);
const peopleFlagSources = peopleFlag ? await sourceLine(peopleFlag.sourceIds) : '';
const peopleFlagImg = flagOf(peopleFlag?.flag);
const hasAnyFlag = statehood.entities.some((e) => e.flag) || !!peopleFlagImg;
---

<section class="mb-6 rounded-xl border border-line bg-surface-alt p-5">
  <div class="mb-3 flex flex-wrap items-center gap-3">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-ink-muted">{t('peoples.statehoodTitle')}</h2>
    <StatehoodBadge lang={lang} statehood={statehood} />
  </div>

  {statehood.entities.length > 0 && (
    <ul class="mb-3 grid gap-3 sm:grid-cols-2">
      {statehood.entities.map((e) => {
        const f = flagOf(e.flag);
        return (
          <li class="flex items-center gap-3">
            {f ? (
              <a href={f.commons} class="shrink-0" title={t('peoples.officialFlag')}>
                <img src={f.file} alt={`${t('peoples.officialFlag')}: ${e.name}`} class="h-12 w-[4.5rem] rounded object-cover shadow ring-1 ring-black/10" loading="lazy" />
              </a>
            ) : (
              <span class="flex h-12 w-[4.5rem] shrink-0 items-center justify-center rounded border border-dashed border-line text-center text-[0.65rem] leading-tight text-ink-muted">
                {t('peoples.noFlag')}
              </span>
            )}
            <div class="text-sm">
              <p class="font-semibold text-ink">{e.name}</p>
              {e.country && <p class="text-ink-muted">{t('peoples.withinCountry', { country: e.country })}</p>}
              {e.noFlagNote && <p class="text-xs text-ink-muted">{e.noFlagNote}</p>}
            </div>
          </li>
        );
      })}
    </ul>
  )}

  {statehood.note && <p class="mb-2 text-sm text-ink-muted">{statehood.note}</p>}
  <p class="text-xs text-ink-muted">{t('states.symbolSource')}: {statehoodSources}</p>

  {peopleFlag && peopleFlagImg && (
    <div class="mt-4 flex flex-wrap items-start gap-3 border-t border-line pt-4">
      <a href={peopleFlagImg.commons} class="shrink-0">
        <img src={peopleFlagImg.file} alt={peopleFlag.name} class="h-12 w-[4.5rem] rounded object-cover shadow ring-1 ring-black/10" loading="lazy" />
      </a>
      <div class="min-w-0 flex-1 text-sm">
        <p class="text-xs font-semibold uppercase tracking-wide text-ink-muted">{t('peoples.peopleFlagTitle')}</p>
        <p class="font-semibold text-ink">{peopleFlag.name}</p>
        <p class="text-ink-muted">{peopleFlag.note}</p>
        <p class="mt-1 text-xs text-ink-muted">{t('states.symbolSource')}: {peopleFlagSources}</p>
      </div>
    </div>
  )}

  {hasAnyFlag && <p class="mt-3 text-[0.7rem] text-ink-muted">{t('peoples.flagCredit')}</p>}
</section>
