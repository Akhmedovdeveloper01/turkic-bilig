---
/**
 * Sulola silsilasi: rasmli kartochkalar va otadan farzandga strelkalar (SVG).
 * Joylashuv build vaqtida hisoblanadi (src/lib/familyTree.ts). `focus` berilsa,
 * shu shaxs ajratiladi, uning ota-bobolari chizig'i rangli bo'ladi va chizma
 * ochilganda unga suriladi. Ekran o'quvchilar uchun har bir kartochka nomida
 * otasi ham aytiladi.
 */
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { createTranslator } from '../../i18n/ui';
import { layoutTree, lineage, NODE_H, NODE_W } from '../../lib/familyTree';

interface Props {
  lang: string;
  id: string;
  /** false — sarlavha ko'rinmaydi (faqat ekran o'quvchilar uchun). */
  heading?: boolean;
  /** Ajratib ko'rsatiladigan a'zo (`members[].id`). */
  focus?: string;
}
const { lang, id, heading = true, focus } = Astro.props;
const t = createTranslator(lang);

const facts = (await getEntry('dynastyFacts', id))!;
const localized = await getEntry('dynasties', `${lang}/${id}`);
const entry = (localized ?? (await getEntry('dynasties', `uz/${id}`)))!;
const uzEntry = localized ? await getEntry('dynasties', `uz/${id}`) : entry;
const sources = (await Promise.all(facts.data.sources.map((r) => getEntry(r)))).filter((s) => s !== undefined);

const layout = layoutTree(facts.data.members);
const line = focus ? lineage(layout, focus) : new Set<string>();
const titleOf = async (c: 'rulers' | 'scholars', slug: string) =>
  ((await getEntry(c, `${lang}/${slug}`)) ?? (await getEntry(c, `uz/${slug}`)))?.data.title;

const members = new Map(
  await Promise.all(
    facts.data.members.map(async (m) => {
      const rulerFacts = m.ruler ? await getEntry(m.ruler) : undefined;
      const scholarFacts = m.scholar ? await getEntry(m.scholar) : undefined;
      // Allomalar ro'yxatidagi hukmdor (scholar orqali) — sahifasi allomalar bo'limida.
      const viaScholar = rulerFacts?.data.scholar?.id;
      const href = scholarFacts
        ? `/${lang}/allomalar/${scholarFacts.id}`
        : viaScholar
          ? `/${lang}/allomalar/${viaScholar}`
          : rulerFacts
            ? `/${lang}/hukmdorlar/${rulerFacts.id}`
            : null;
      const portraitSrc =
        rulerFacts?.data.portrait?.src ??
        scholarFacts?.data.portrait?.src ??
        (viaScholar ? (await getEntry('scholarFacts', viaScholar))?.data.portrait?.src : undefined);
      const name =
        entry.data.names[m.id] ??
        uzEntry?.data.names[m.id] ??
        (scholarFacts ? await titleOf('scholars', scholarFacts.id) : undefined) ??
        (rulerFacts ? await titleOf('rulers', rulerFacts.id) : undefined) ??
        m.id;
      const approx = m.datesUncertain ? '≈ ' : '';
      const dates = m.birthYear || m.deathYear ? `${approx}${m.birthYear ?? '?'} – ${m.deathYear ?? '?'}` : null;
      const initials = name.split(/[\s'ʻ’-]+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase();
      const note = entry.data.notes[m.id] ?? uzEntry?.data.notes[m.id];
      return [m.id, { ...m, name, href, portraitSrc, dates, initials, note }] as const;
    })
  )
);

const reignText = (r: { from: number; to: number }) => t('dynasty.reignShort', { from: String(r.from), to: String(r.to) });
// Ekran o'quvchilar uchun har bir kartochka nomida otasi ham aytiladi — silsila tuzilmasi yo'qolmaydi.
const ariaLabel = (nid: string) => {
  const m = members.get(nid)!;
  const parts = [m.name, m.dates, m.reign && reignText(m.reign), m.note];
  if (m.parent) parts.push(t('dynasty.childOf', { name: members.get(m.parent)!.name }));
  return parts.filter(Boolean).join(', ');
};
const markerId = `arrow-${id}`;
const markerHiId = `arrow-hi-${id}`;
---

<figure class="mb-8" aria-labelledby={`dynasty-${id}-title`}>
  <figcaption class="mb-3">
    <h3 id={`dynasty-${id}-title`} class:list={['text-lg font-semibold text-ink', !heading && 'sr-only']}>{entry.data.title}</h3>
    {heading && <p class="mt-1 max-w-3xl text-sm text-ink-muted">{entry.data.summary}</p>}
  </figcaption>

  <div data-tree data-w={layout.width} data-h={layout.height}>
  <div class="mb-2 flex flex-wrap items-center gap-1.5" role="toolbar" aria-label={t('dynasty.zoomToolbar')} data-tree-toolbar hidden>
    <button type="button" class="tb-zoom-btn" data-zoom="out" aria-label={t('dynasty.zoomOut')} title={t('dynasty.zoomOut')}>
      <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14" stroke-linecap="round"></path></svg>
    </button>
    <output class="w-12 text-center text-xs font-medium tabular-nums text-ink-muted" data-zoom-value aria-live="polite">100%</output>
    <button type="button" class="tb-zoom-btn" data-zoom="in" aria-label={t('dynasty.zoomIn')} title={t('dynasty.zoomIn')}>
      <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke-linecap="round"></path></svg>
    </button>
    <button type="button" class="tb-zoom-btn gap-1.5 px-2.5" data-zoom="fit" title={t('dynasty.zoomFit')}>
      <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      <span class="text-xs font-medium">{t('dynasty.zoomFitShort')}</span>
    </button>
    <button type="button" class="tb-zoom-btn px-2.5 text-xs font-medium" data-zoom="reset" title={t('dynasty.zoomReset')} aria-label={t('dynasty.zoomReset')}>1:1</button>
    <span class="ms-1 hidden text-xs text-ink-muted sm:inline">{t('dynasty.zoomHint')}</span>
  </div>
  <div class="tb-tree max-h-[75vh] overflow-auto rounded-xl border border-line bg-surface p-4" style="touch-action: pan-x pan-y" tabindex="0" role="group" aria-label={entry.data.title} data-tree-scroll>
    <div class="relative" style={`width:${layout.width}px;height:${layout.height}px`} data-tree-sizer>
    <div class="absolute start-0 top-0 origin-top-left rtl:origin-top-right" style={`width:${layout.width}px;height:${layout.height}px;transform:scale(var(--tb-zoom,1))`} data-tree-canvas>
      <svg aria-hidden="true" class="absolute inset-0 rtl:-scale-x-100" width={layout.width} height={layout.height} viewBox={`0 0 ${layout.width} ${layout.height}`}>
        <defs>
          <marker id={markerId} viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M0 0 L10 5 L0 10 z" class="fill-line"></path>
          </marker>
          <marker id={markerHiId} viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M0 0 L10 5 L0 10 z" class="fill-brand"></path>
          </marker>
        </defs>
        {layout.edges.map((e) => {
          const hi = line.has(e.from) && line.has(e.to);
          return (
            <path
              d={e.d}
              fill="none"
              class={hi ? 'stroke-brand' : 'stroke-line'}
              stroke-width={hi ? 2.5 : 1.5}
              stroke-linejoin="round"
              marker-end={`url(#${hi ? markerHiId : markerId})`}
            ></path>
          );
        })}
      </svg>

      {layout.order.map((nid) => {
        const n = layout.nodes.get(nid)!;
        const m = members.get(nid)!;
        const Tag = m.href ? 'a' : 'div';
        const isFocus = nid === focus;
        return (
          <Tag
            href={m.href ?? undefined}
            title={m.note}
            class:list={[
              'absolute flex items-center gap-2 rounded-lg border px-2 py-1.5 text-start transition-colors',
              m.reign ? 'border-brand/50 bg-surface-alt' : 'border-line bg-surface',
              line.has(nid) && !isFocus && 'border-brand',
              isFocus && 'z-10 border-brand bg-brand/10 ring-2 ring-brand',
              m.href && 'hover:border-brand hover:shadow-md',
            ]}
            style={`inset-inline-start:${n.x}px;top:${n.y}px;width:${NODE_W}px;height:${NODE_H}px`}
            aria-label={ariaLabel(nid)}
            aria-current={isFocus ? 'true' : undefined}
            data-tree-focus={isFocus ? (m.parent ? '' : 'root') : undefined}
          >
            <span class="relative shrink-0">
              {m.portraitSrc ? (
                <Image src={m.portraitSrc} alt="" widths={[40, 80]} sizes="40px" class="size-10 rounded-full border border-line object-cover object-top" />
              ) : (
                <span class="flex size-10 items-center justify-center rounded-full bg-brand/10 text-xs font-semibold text-brand-dark dark:text-brand">{m.initials}</span>
              )}
              {m.reign && (
                <span class="absolute -end-1 -top-1 flex size-4 items-center justify-center rounded-full bg-gold text-surface">
                  <svg viewBox="0 0 24 24" class="size-2.5" fill="currentColor" aria-hidden="true"><path d="M3 18h18l-1.5-10-4.5 4-3-7-3 7-4.5-4z"></path></svg>
                </span>
              )}
            </span>
            <span class="min-w-0 leading-tight">
              <span class="block truncate text-[0.8rem] font-semibold text-ink">{m.name}</span>
              {m.dates && <span class="block text-[0.7rem] tabular-nums text-ink-muted"><bdi dir="ltr">{m.dates}</bdi></span>}
              {m.reign ? (
                <span class="block truncate text-[0.68rem] tabular-nums text-brand">{reignText(m.reign)}{m.note && ` · ${m.note}`}</span>
              ) : (
                m.note && <span class="block truncate text-[0.68rem] text-ink-muted">{m.note}</span>
              )}
            </span>
          </Tag>
        );
      })}
    </div>
    </div>
  </div>
  </div>

  <div class="mt-2 flex flex-wrap items-center gap-x-5 gap-y-1 text-xs text-ink-muted">
    <span class="inline-flex items-center gap-1.5">
      <span class="flex size-4 items-center justify-center rounded-full bg-gold text-surface" aria-hidden="true">
        <svg viewBox="0 0 24 24" class="size-2.5" fill="currentColor"><path d="M3 18h18l-1.5-10-4.5 4-3-7-3 7-4.5-4z"></path></svg>
      </span>
      {t('dynasty.ruled')}
    </span>
    <span class="inline-flex items-center gap-1.5"><span aria-hidden="true" class="rtl:-scale-x-100">→</span>{t('dynasty.arrow')}</span>
    {focus && <span class="inline-flex items-center gap-1.5"><span class="h-0.5 w-5 rounded bg-brand" aria-hidden="true"></span>{t('dynasty.lineage')}</span>}
    <span>{t('states.symbolSource')}: {sources.map((s) => (s.data.year ? `${s.data.author} (${s.data.year})` : s.data.title)).join('; ')}</span>
  </div>
</figure>

<script>
  // Silsilani kattalashtirish / kichraytirish. Chizma CSS scale bilan o'zgaradi, tashqi
  // "sizer" esa aylantirish (scroll) maydonini yangi o'lchamga moslaydi. Kattalashtirishda
  // ko'rsatkich (yoki oyna markazi) ostidagi nuqta joyida qoladi; RTL'da scrollLeft
  // manfiy bo'lgani hisobga olinadi. JavaScript bo'lmasa chizma 100% da ishlayveradi.
  const MIN = 0.25;
  const MAX = 1.75;
  const STEP = 1.2;

  function init(tree: HTMLElement) {
    if (tree.dataset.ready) return;
    tree.dataset.ready = '1';
    const box = tree.querySelector<HTMLElement>('[data-tree-scroll]')!;
    const sizer = tree.querySelector<HTMLElement>('[data-tree-sizer]')!;
    const canvas = tree.querySelector<HTMLElement>('[data-tree-canvas]')!;
    const value = tree.querySelector<HTMLElement>('[data-zoom-value]')!;
    const toolbar = tree.querySelector<HTMLElement>('[data-tree-toolbar]')!;
    const W = Number(tree.dataset.w);
    const H = Number(tree.dataset.h);
    const rtl = getComputedStyle(box).direction === 'rtl';
    let z = 1;
    toolbar.hidden = false;

    const pad = () => parseFloat(getComputedStyle(box).paddingLeft) * 2;
    // Oynadagi nuqta (start chetidan) — kontent koordinatasiga va aksincha.
    const startScroll = () => (rtl ? -box.scrollLeft : box.scrollLeft);
    const setStartScroll = (v: number) => (box.scrollLeft = rtl ? -v : v);

    function setZoom(next: number, ax?: number, ay?: number) {
      next = Math.min(MAX, Math.max(MIN, next));
      const ox = ax ?? box.clientWidth / 2;
      const oy = ay ?? box.clientHeight / 2;
      const cx = (startScroll() + ox) / z;
      const cy = (box.scrollTop + oy) / z;
      z = next;
      canvas.style.setProperty('--tb-zoom', String(z));
      sizer.style.width = `${W * z}px`;
      sizer.style.height = `${H * z}px`;
      setStartScroll(cx * z - ox);
      box.scrollTop = cy * z - oy;
      value.textContent = `${Math.round(z * 100)}%`;
    }
    const fit = () => setZoom(Math.min(1, (box.clientWidth - pad()) / W, (box.clientHeight - pad()) / H), 0, 0);
    const anchor = (e: { clientX: number; clientY: number }) => {
      const b = box.getBoundingClientRect();
      return [rtl ? b.right - e.clientX : e.clientX - b.left, e.clientY - b.top] as const;
    };

    toolbar.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-zoom]');
      if (!btn) return;
      const k = btn.dataset.zoom;
      if (k === 'in') setZoom(z * STEP);
      else if (k === 'out') setZoom(z / STEP);
      else if (k === 'fit') fit();
      else setZoom(1);
    });
    box.addEventListener('keydown', (e) => {
      if (e.key === '+' || e.key === '=') setZoom(z * STEP);
      else if (e.key === '-') setZoom(z / STEP);
      else if (e.key === '0') fit();
      else return;
      e.preventDefault();
    });
    // Ctrl + g'ildirak (trekpaddagi ikki barmoqli kattalashtirish ham shu hodisa sifatida keladi).
    box.addEventListener(
      'wheel',
      (e) => {
        if (!e.ctrlKey && !e.metaKey) return;
        e.preventDefault();
        const [x, y] = anchor(e);
        setZoom(z * Math.exp(-e.deltaY * 0.002), x, y);
      },
      { passive: false }
    );
    // Sensorli ekranda ikki barmoq bilan.
    const pts = new Map<number, PointerEvent>();
    let startDist = 0;
    let startZ = 1;
    const dist = () => {
      const [a, b] = [...pts.values()];
      return Math.hypot(a.clientX - b.clientX, a.clientY - b.clientY);
    };
    box.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'touch') return;
      pts.set(e.pointerId, e);
      if (pts.size === 2) {
        startDist = dist();
        startZ = z;
      }
    });
    box.addEventListener('pointermove', (e) => {
      if (!pts.has(e.pointerId)) return;
      pts.set(e.pointerId, e);
      if (pts.size !== 2 || !startDist) return;
      const [a, b] = [...pts.values()];
      const [x, y] = anchor({ clientX: (a.clientX + b.clientX) / 2, clientY: (a.clientY + b.clientY) / 2 });
      setZoom(startZ * (dist() / startDist), x, y);
    });
    const up = (e: PointerEvent) => {
      pts.delete(e.pointerId);
      if (pts.size < 2) startDist = 0;
    };
    box.addEventListener('pointerup', up);
    box.addEventListener('pointercancel', up);

    // Ajratilgan shaxs bo'lsa — unga suriladi (telefonda atrofi ham ko'rinishi uchun 60% da);
    // bo'lmasa butun silsila sig'diriladi.
    const node = box.querySelector<HTMLElement>('[data-tree-focus]');
    if (node && node.dataset.treeFocus === 'root' && W > box.clientWidth) {
      // Ildiz (masalan, sulola asoschisi) — butun silsila uning avlodlari, shuning uchun sig'diriladi.
      fit();
    } else if (node) {
      if (box.clientWidth < 640) setZoom(0.6, 0, 0);
      const b = box.getBoundingClientRect();
      const n = node.getBoundingClientRect();
      box.scrollBy({ left: n.left - b.left - b.width / 2 + n.width / 2, top: n.top - b.top - b.height / 2 + n.height / 2 });
    } else if (W > box.clientWidth) {
      fit();
    }
  }

  const run = () => document.querySelectorAll<HTMLElement>('[data-tree]').forEach(init);
  run();
  document.addEventListener('astro:page-load', run);
</script>
