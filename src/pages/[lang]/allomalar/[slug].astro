---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import VerifiedBadge from '../../../components/VerifiedBadge.astro';
import TranslationNotice from '../../../components/TranslationNotice.astro';
import DisputedList from '../../../components/DisputedList.astro';
import SourcesList from '../../../components/SourcesList.astro';
import { locales } from '../../../i18n/locales';
import { createTranslator } from '../../../i18n/ui';
import { formatYear } from '../../../i18n/years';
import ScholarCategoryBadge from '../../../components/scholars/ScholarCategoryBadge.astro';
import ScholarPortrait from '../../../components/scholars/ScholarPortrait.astro';

export async function getStaticPaths() {
  const facts = await getCollection('scholarFacts');
  return locales.flatMap((locale) =>
    facts.map((fact) => ({ params: { lang: locale.code, slug: fact.id } }))
  );
}

const { lang, slug } = Astro.params;
const t = createTranslator(lang!);

const localized = await getEntry('scholars', `${lang}/${slug}`);
const entry = localized ?? (await getEntry('scholars', `uz/${slug}`));

if (!entry) {
  return Astro.redirect(`/${lang}/allomalar`);
}

const isFallback = !localized;
const facts = await getEntry(entry.data.factsId);
const { Content } = await render(entry);

const sourceEntries = facts
  ? await Promise.all(facts.data.sources.map((ref) => getEntry(ref)))
  : [];

const stateEntries = facts
  ? await Promise.all(
      facts.data.relatedStates.map(async (ref) => {
        const localizedState = await getEntry('states', `${lang}/${ref.id}`);
        return localizedState ?? (await getEntry('states', `uz/${ref.id}`));
      })
    )
  : [];

const yearOrNull = (year: number | undefined, era: 'm.av' | 'milodiy') =>
  year === undefined ? null : formatYear(t, year, era);
const birth = facts ? yearOrNull(facts.data.birthYear, facts.data.birthEra) : null;
const death = facts ? yearOrNull(facts.data.deathYear, facts.data.deathEra) : null;
---

<BaseLayout lang={lang!} title={entry.data.title} description={entry.data.summary}>
  <div class="mb-4 flex flex-wrap items-center gap-2">
    <h1 class="text-3xl font-bold tracking-tight text-ink">{entry.data.title}</h1>
    <VerifiedBadge lang={lang!} verified={facts?.data.verified ?? false} />
    {facts && <ScholarCategoryBadge lang={lang!} category={facts.data.category} />}
  </div>

  {isFallback && <TranslationNotice lang={lang!} />}

  {facts?.data.portrait && <ScholarPortrait lang={lang!} name={entry.data.title} portrait={facts.data.portrait} />}

  <p class="mb-6 text-lg text-ink-muted">{entry.data.summary}</p>

  {facts && (
    <section class="mb-6 flex flex-wrap gap-6 rounded-xl border border-line bg-surface-alt p-5 text-sm">
      {(birth || death) && (
        <div>
          <p class="font-semibold uppercase tracking-wide text-ink-muted">{t('common.period')}</p>
          <p class="text-ink">
            {birth ?? '?'} — {death ?? '?'}
            {facts.data.datesUncertain && <span class="ms-1 text-xs text-gold">({t('common.approximate')})</span>}
          </p>
        </div>
      )}
      <div>
        <p class="font-semibold uppercase tracking-wide text-ink-muted">{t('common.field')}</p>
        <p class="text-ink">{facts.data.field.join(', ')}</p>
      </div>
    </section>
  )}

  <article class="prose prose-slate max-w-none dark:prose-invert">
    <Content />
  </article>
  <div class="clear-both"></div>

  {stateEntries.length > 0 && (
    <section class="mt-8">
      <h2 class="mb-3 text-lg font-semibold text-ink">{t('nav.states')}</h2>
      <ul class="flex flex-wrap gap-2">
        {stateEntries.map((s) => s && (
          <li>
            <a
              href={`/${lang}/davlatlar/${s.id.split('/').slice(1).join('/')}`}
              class="inline-block rounded-full border border-line bg-surface-alt px-3 py-1 text-sm text-ink transition-colors hover:border-brand/40 hover:text-brand"
            >
              {s.data.title}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {facts && <DisputedList lang={lang!} topics={facts.data.disputed} />}

  <SourcesList lang={lang!} sources={sourceEntries} />
</BaseLayout>
